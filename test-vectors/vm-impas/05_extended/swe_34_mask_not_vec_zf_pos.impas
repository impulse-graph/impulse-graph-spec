; ====================================================================
; SWE_34: OP_MASK_NOT on float vector updates ZF when all outputs are 0.0 (Positive Test)
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R2 = 0}
; {EXPECT: FLAG = ZF}

.data
.array_float VEC_ONES = [1.0, 1.0]

.text
0x00: OP_LOAD_INLINE_ARRAY   R0, VEC_ONES
0x01: OP_MASK_NOT            R1, R0
0x02: OP_VECTOR_REDUCE_SUM   R2, R1
0x03: OP_HALT
