; ====================================================================
; TDD_24_STREAM_IDS: Test SRC and EDGE IDs
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_SUCCESS}
; {EXPECT: R5 = 1077936128} ; 3.0 (Edge IDs 0,1,2 summed)

.data
.csr_inline GRAPH_A = {
    0: [1, 2, 3]
}

.text
OP_INIT_MOCK_GRAPH R0, GRAPH_A
OP_INIT_INPUT_NODE R3, 0
OP_CLEAR_REG R4
OP_CLEAR_REG R5
OP_LOAD_CONST_INT R10, 8
OP_COO_WALK_STREAM R0, R3, 0, 9
OP_VECTOR_REDUCE_SUM R5, R4
OP_HALT

OP_STREAM_FUNC_BEGIN
OP_STREAM_LOAD_SRC_ID 0
OP_STREAM_LOAD_EDGE_ID 1
OP_STREAM_MATH_ADD 2, 0, 1
OP_STREAM_REDUCE 2, 4, 0
OP_STREAM_FUNC_END
