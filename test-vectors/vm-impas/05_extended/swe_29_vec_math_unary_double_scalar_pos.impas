; ====================================================================
; SWE_29: OP_VEC_MATH_UNARY scalar mode with flags=1 emits TDouble (Positive Test)
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R1 = 4613937818241073152} ; 3.0 (f64 abs(-3.0))

.text
0x00: OP_LOAD_CONST_FLOAT    R0, -3.0
0x01: OP_VEC_MATH_UNARY      R1, R0, 1, 1 ; abs(-3.0) with flags=1 -> TDouble 3.0
0x02: OP_HALT
