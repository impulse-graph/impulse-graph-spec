; ====================================================================
; GEN_DOMAIN_POWERGRID_N1_SCREENING_POS
; 6-Bus Power Grid N-1 Contingency Screening across 4 Lanes:
; - Buses 0, 1, 2, 3 form a redundant ring:
;   u=0: e0=1, e1=2
;   u=1: e2=0, e3=2
;   u=2: e4=1, e5=3
;   u=3: e6=0, e7=4 (radial bridge to bus 4)
;   u=4: e8=5 (radial bridge to bus 5)
;   u=5: []
; - Contingencies (lanes 0..3 seeded on redundant ring buses 0..3):
;   Lane 0 trips e0 (0->1) -> ring stays connected via 0->2->1 (no island, bit 0 = 0)
;   Lane 1 trips e7 (3->4 bridge) -> isolates buses 4 & 5! (bit 1 = 1)
;   Lane 2 trips e1 (0->2) -> ring stays connected via 0->1->2 (no island, bit 2 = 0)
;   Lane 3 trips e8 (4->5 bridge) -> isolates bus 5! (bit 3 = 1)
; - Expected island contingency mask in R6 = 0b1010 = 10
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R6 = 10}
; {EXPECT: FLAG = !ZF}

.data
.csr_inline GRID_6 = {
    0: [1, 2],
    1: [0, 2],
    2: [1, 3],
    3: [0, 4],
    4: [5],
    5: []
}
.set RING_SEEDS = [0, 1, 2, 3]

.text
0x00: OP_INIT_MOCK_GRAPH         R0, GRID_6
0x01: OP_LOAD_INLINE_SET         R1, RING_SEEDS
0x02: OP_LANE_INIT_SEEDS         R3, R1, 0
0x03: OP_LOAD_CONST_INT          R2, 0
0x04: OP_LANE_SET_EDGE_MASK      R4, R3, R2, 0, 0
0x05: OP_LOAD_CONST_INT          R2, 7
0x06: OP_LANE_SET_EDGE_MASK      R4, R4, R2, 0, 1
0x07: OP_LOAD_CONST_INT          R2, 1
0x08: OP_LANE_SET_EDGE_MASK      R4, R4, R2, 0, 2
0x09: OP_LOAD_CONST_INT          R2, 8
0x0A: OP_LANE_SET_EDGE_MASK      R4, R4, R2, 0, 3
0x0B: OP_LANE_CSR_WALK           R5, R4, 0, 4
0x0C: OP_LANE_REDUCE_AND         R6, R5, 6, 1
0x0D: OP_HALT
