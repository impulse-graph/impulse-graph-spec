; {{EXPECT: STATUS = IMPULSE_VM_OK}}
; {{EXPECT: F2 = [1, 2, 3] (dom=0)}}
; {{EXPECT: R0 = 2}}

.data
  .domain 0 name="Node" count=6 width=u16
  .relation 0 name="E" src_dom=0 tgt_dom=0
  ; Node 0 -> [1, 2, 3, 4, 5] (deg=5); Node 1 -> [2, 3] (deg=2)
  .csr_inline rel=0 offsets=[0, 5, 7, 7, 7, 7, 7] targets=[1, 2, 3, 4, 5, 2, 3]
  .param 0 type=u64_vec values=[0, 1]

.code
  LOAD_CONST.u64.ext            R1, 0x123456789ABCDEF0
  ; deg(1)=2 <= k=3 -> all neighbors {2, 3}
  FSEED.single_imm              F0, lo=1, hi=0
  SAMPLE_NEIGHBORS.frontier_wor F1, F0, R1, rel=0, k=3
  ; deg(0)=5 > k=2 -> Floyd's O(k) samples exactly 2 distinct neighbors
  FSEED.single_imm              F3, lo=0, hi=0
  SAMPLE_NEIGHBORS.frontier_wor F4, F3, R1, rel=0, k=2
  SET_CARDINALITY.card_1bit     R0, F4

  ; Union {1} with {2,3} into F2 for deterministic check
  FSEED.single_imm              F2, lo=1, hi=0
  SET_OP.union                  F2, F2, F1

  ; vec_wr (k=2 on [0, 1] -> len 4), rw_step_fwd, rw_step_stay
  LOAD_PARAM.vec                V0, param=0, type=u64
  SAMPLE_NEIGHBORS.vec_wr       V1, V0, R1, rel=0, k=2
  SAMPLE_NEIGHBORS.rw_step_fwd  V2, V0, R1, rel=0, k=1
  SAMPLE_NEIGHBORS.rw_step_stay V3, V0, R1, rel=0, k=1
  HALT
