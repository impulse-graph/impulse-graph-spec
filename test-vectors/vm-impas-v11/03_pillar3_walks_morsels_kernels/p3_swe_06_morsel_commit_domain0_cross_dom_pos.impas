; {{EXPECT: STATUS = IMPULSE_VM_OK}}
; {{EXPECT: F1 = [0, 2] (dom=0)}}
; SWE-Sweep TDD: Cross-domain WALK_MORSEL (dom 0 -> dom 1) committing source nodes M0 with dom=0 must produce F1 in dom=0, not dom=1.

.data
  .domain 0 name="User" count=3 width=u16
  .domain 1 name="Item" count=4 width=u16
  .relation 0 name="BOUGHT" src_dom=0 tgt_dom=1
  .csr_inline rel=0 offsets=[0, 1, 1, 2] targets=[1, 3]

.code
  INIT_DOMAIN_SPAN.all_span F0, dom=0
  WALK_MORSEL.fwd           F0, rel=0
    MORSEL_COMMIT.yield_frontier F1, M0, dom=0
  MORSEL_END
  HALT
