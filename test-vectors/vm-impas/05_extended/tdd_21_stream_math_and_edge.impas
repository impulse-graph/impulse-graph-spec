; ====================================================================
; TDD_21_STREAM_MATH_AND_EDGE: Loaders and Binary Math
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_SUCCESS}
; {EXPECT: R5 = 1112014848}

.data
.csr_inline  GRAPH_A = {
    0: [1, 2],
    1: [2]
}
.array_float ATTR_SOURCE = [10.0, 20.0, 30.0]
.array_float ATTR_EDGE = [2.0, 3.0, 4.0]

.text
OP_INIT_MOCK_GRAPH R0, GRAPH_A
OP_LOAD_INLINE_ARRAY R1, ATTR_SOURCE
OP_LOAD_INLINE_ARRAY R2, ATTR_EDGE
OP_INIT_MOCK_NODE_ATTR R1, R1, 63
OP_INIT_MOCK_NODE_ATTR R2, R2, 63

OP_INIT_INPUT_NODE R3, 0
OP_CLEAR_REG R4
OP_CLEAR_REG R5
OP_LOAD_CONST_INT R10, 12
OP_COO_WALK_STREAM R0, R3, 0, 9
OP_VECTOR_REDUCE_SUM R5, R4
OP_HALT

OP_STREAM_FUNC_BEGIN
OP_STREAM_LOAD_SRC 0, 1
OP_STREAM_LOAD_EDGE 1, 2
OP_STREAM_MATH_MUL 2, 0, 1
OP_STREAM_REDUCE 2, 4, 0
OP_STREAM_FUNC_END
