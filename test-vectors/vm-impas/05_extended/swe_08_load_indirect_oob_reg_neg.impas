; ====================================================================
; SWE_08: OP_LOAD_INDIRECT out-of-bounds register R64 (Negative Test)
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_ERR_INVALID_REGISTER}

.data
.array_float WEIGHTS = [1.0, 2.0]

.text
0x00: OP_LOAD_INLINE_ARRAY   R1, WEIGHTS
0x01: OP_LOAD_CONST_INT      R2, 0
0x02: OP_LOAD_INDIRECT       R64, R1, R2, 1
0x03: OP_HALT
