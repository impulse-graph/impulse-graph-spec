; {{EXPECT: STATUS = IMPULSE_VM_OK}}
; {{EXPECT: R0 = NULL}}
; {{EXPECT: R0_TYPE = null}}
; {{EXPECT: R1 = -0.0}}
; {{EXPECT: R1_TYPE = f64}}
; {{EXPECT: R2 = -0.0}}
; {{EXPECT: R2_TYPE = f64}}
; {{EXPECT: F0 = [] (dom=0)}}
; {{EXPECT: ZF = 1, NF = 0}}

.data
  .domain 0 name="Node" count=4 width=u16
  .param 0 type=frontier dom=0 values=[2]
  .param 1 type=f64_vec values=[1.5]

.code
  ; Swap valid -0.0 (f64) with NULL (null) -> preserves both r_valid_mask and r_type_word
  LOAD_CONST.f64.ext  R0, 0x8000000000000000
  LOAD_CONST.null     R1
  SWAP.r              R0, R1                ; R0=NULL, R1=-0.0
  SPILL.r             R1, slot=7
  RELOAD.r            R2, slot=7            ; R2=-0.0, ZF=1, NF=0
  MOV.r               R3, R2
  MOV.clear_r         R3

  LOAD_PARAM.frontier F1, param=0, dom=0
  MOV.clear_f         F0, dom=0
  SWAP.f              F0, F1                ; F0=[2], F1=[]
  MOV.f               F2, F1                ; F2=[]
  SPILL.f             F2, slot=8
  RELOAD.f            F0, slot=8            ; F0=[]

  LOAD_PARAM.vec      V0, param=1, type=f64
  MOV.v               V0, V0                ; self-move safety
  SPILL.v             V0, slot=9
  MOV.clear_v         V0
  RELOAD.v            V1, slot=9
  SWAP.v              V0, V1
  MOV.r               R2, R1                ; final flags: ZF=1, NF=0 (-0.0)
  HALT
