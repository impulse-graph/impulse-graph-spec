; {{EXPECT: STATUS = IMPULSE_VM_OK}}
; {{EXPECT: F0 = [] (dom=0)}}
; {{EXPECT: F1 = [] (dom=0)}}
; {{EXPECT: R0 = 0.0}}
; {{EXPECT: R1 = 0.0}}
; {{EXPECT: R2 = 1.5}}
; {{EXPECT: ST = 0, ZF = 0, NF = 0}}

.data
  .domain 0 name="Node" count=4 width=u16
  .param 0 type=i64_vec values=[null, null]
  .param 1 type=bool_3vl_vec values=[null, false, null, false]
  .param 2 type=f64_vec values=[1.0, null, 2.0, 3.0]
  .param 3 type=f64_vec values=[1.0, null, 2.0, 3.0]
  .param 4 type=f64_vec values=[1.0, 5.0, 2.0, 3.0]
  .param 5 type=f64_vec values=[1.0, null, 3.5, 3.0]

.code
  ; All-NULL vectors collapse cleanly to EMPTY frontiers
  LOAD_PARAM.vec           V0, param=0, type=i64
  SET_CONVERT.v2f_ids      F0, V0, lo=0
  ASSERT.empty_f           F0, 40
  SET_CONVERT.f2v_ids      V1, F0
  SET_CONVERT.f2b          V2, F0
  LOAD_PARAM.vec           V3, param=1, type=bool
  SET_CONVERT.b2f          F1, V3, lo=0
  ASSERT.empty_f           F1, 41
  STABLE_CHECK.frontier_eq F0, F1
  ASSERT.st_set            42

  ; STABLE_CHECK.vec_l1:
  ; 1) Both-NULL at index 1 contributes 0.0 and converges (d=0.0 <= 0.1 -> ST=1)
  LOAD_CONST.f64.ext       R5, 0.1
  LOAD_PARAM.vec           V4, param=2, type=f64
  LOAD_PARAM.vec           V5, param=3, type=f64
  STABLE_CHECK.vec_l1      R0, V4, V5, R5
  ASSERT.st_set            43

  ; 2) One-sided NULL mismatch (NULL vs 5.0 at index 1): d=0.0 <= 0.1, BUT ST MUST BE 0!
  LOAD_PARAM.vec           V6, param=4, type=f64
  STABLE_CHECK.vec_l1      R1, V4, V6, R5
  JCC.jst                  bad_null_converge

  ; 3) Finite delta 1.5 > 0.1 -> ST=0, ZF=0
  LOAD_PARAM.vec           V7, param=5, type=f64
  STABLE_CHECK.vec_l1      R2, V4, V7, R5
  HALT
bad_null_converge:
  THROW.imm                44
