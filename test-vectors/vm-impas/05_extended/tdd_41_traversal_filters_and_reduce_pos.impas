; ====================================================================
; TDD_41_TRAVERSAL_FILTERS_AND_REDUCE_POS: Issue #23
; Tests:
; 1. OP_CSR_WALK_FILTERED clears existing bitset in dst before walking.
; 2. OP_CSC_WALK 2-operand with rel=1 does not collide with R1 holding
;    a TYPE_BITSET_HANDLE.
; 3. OP_CSR_WALK_DIRECT_STORE updates IMPULSE_VM_FLAG_ZF on empty walk.
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R10 = 1}
; {EXPECT: R11 = 2}
; {EXPECT: R12 = 1}

.data
.csr_inline GRAPH_REL0 = {
    0: [1, 2]
}
.csr_inline GRAPH_REL1 = {
    0: [3],
    1: [3]
}
.set SET_STALE = [1, 2, 3, 4]
.set SET_FLT = [2]

.text
0x00: OP_INIT_MOCK_GRAPH       R0, GRAPH_REL0
0x01: OP_INIT_MOCK_GRAPH       R1, GRAPH_REL1

; 1. OP_CSR_WALK_FILTERED into pre-populated bitset R4
0x02: OP_LOAD_INLINE_SET       R4, SET_STALE
0x03: OP_LOAD_INLINE_SET       R3, SET_FLT
0x04: OP_INIT_INPUT_NODE       R2, 0
0x05: OP_CSR_WALK_FILTERED     R4, R2, R3, 0
0x06: OP_SET_CARDINALITY       R10, R4

; 2. OP_CSC_WALK 2-operand on relation 1 while R1 holds TYPE_BITSET_HANDLE
0x07: OP_LOAD_INLINE_SET       R1, SET_STALE
0x08: OP_INIT_INPUT_NODE       R5, 3
0x09: OP_CSC_WALK              R6, R5, 1
0x0A: OP_SET_CARDINALITY       R11, R6

; 3. OP_CSR_WALK_DIRECT_STORE from node 9 (empty) sets ZF = 1
0x0B: OP_INIT_INPUT_NODE       R7, 9
0x0C: OP_CSR_WALK_DIRECT_STORE R8, R7, 0
0x0D: OP_JZ                    3
0x0E: OP_LOAD_CONST_INT        R12, 0
0x0F: OP_JMP                   2
0x10: OP_LOAD_CONST_INT        R12, 1
0x11: OP_HALT
