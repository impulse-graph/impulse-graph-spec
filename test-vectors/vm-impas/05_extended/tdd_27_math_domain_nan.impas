; ====================================================================
; TDD 27: Math Ops Domain Issues - Nulls / NaNs
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_ERR_FLOATING_POINT}

.data
.array_float VEC_NEG = [-1.0, -4.0, -9.0]

.text
0x00: OP_LOAD_INLINE_ARRAY R0, VEC_NEG
0x01: OP_VEC_MATH_UNARY R1, R0, 0x02 ; sqrt(neg) -> NaN
0x02: OP_ASSERT_FINITE R1 ; assert finite -> throws IMPULSE_VM_ERR_FLOATING_POINT
0x03: OP_HALT
