; {{EXPECT: STATUS = IMPULSE_VM_OK}}
; {{EXPECT: R10 = 1}}
; {{EXPECT: R11 = 1}}
; {{EXPECT: F8 = [0] (dom=0)}}
; {{EXPECT: F9 = [3] (dom=0)}}
; ALGO07 (ported from v0.10): Directed Cycle Detection & Frontier Partitioning
; Chains 3-hop WALK.fwd with visited history accumulation, detecting back-edges
; via SET_OP.intersect and newly discovered nodes via SET_OP.diff.

.data
  .domain 0 name="Node" count=4 width=u16
  .relation 0 name="NEXT" src_dom=0 tgt_dom=0
  .csr_inline rel=0 offsets=[0, 1, 2, 4, 4] targets=[1, 2, 0, 3]

.code
  FSEED.single_imm       F1, node=0, dom=0
  SET_OP.union           F2, F1, F1
  WALK.fwd               F3, F1, rel=0
  SET_OP.intersect       F4, F3, F2
  SET_OP.union           F2, F2, F3
  WALK.fwd               F5, F3, rel=0
  SET_OP.intersect       F6, F5, F2
  SET_OP.union           F2, F2, F5
  WALK.fwd               F7, F5, rel=0
  SET_OP.intersect       F8, F7, F2
  SET_OP.diff            F9, F7, F2
  SET_CARDINALITY        R10, F8
  SET_CARDINALITY        R11, F9
  LOAD_CONST.u32         R12, 1
  SCALAR_3VL.cmp_eq_i64  R13, R10, R12
  ASSERT.true_r          R13
  SCALAR_3VL.cmp_eq_i64  R14, R11, R12
  ASSERT.true_r          R14
  HALT
