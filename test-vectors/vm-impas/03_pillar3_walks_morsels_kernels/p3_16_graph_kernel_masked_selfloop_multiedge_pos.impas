; {{EXPECT: STATUS = IMPULSE_VM_OK}}
; {{EXPECT: R0 = 1}}
; {{EXPECT: F1 = [0, 1, 2] (dom=0)}}
; {{EXPECT: COLLECT_0 = [0, 0, 0, null]}}
; {{EXPECT: COLLECT_1 = [2, 2, 2, null]}}
; {{EXPECT: COLLECT_2 = [1, 1, 1, null]}}

.data
  ; Triangle {0,1,2} WITH self-loops (0->0) and parallel multi-edges (0->1 twice) + node 3 masked out!
  .domain 0 name="Node" count=4 width=u16
  .relation 0 name="E" src_dom=0 tgt_dom=0
  .csr_inline rel=0 offsets=[0, 4, 6, 7, 7] targets=[0, 1, 1, 2, 2, 3, 3]
  .param 0 type=frontier dom=0 values=[0, 1, 2]

.code
  LOAD_PARAM.frontier               F0, param=0, dom=0
  ; Excluded node 3 MUST receive NULL in cc_afforest, kcore_nums, tri_count_vec;
  ; self-loop 0->0 and duplicate 0->1 MUST NOT inflate k-core or triangle counts!
  GRAPH_KERNEL.cc_afforest.mask     V0, F0, rel=0
  GRAPH_KERNEL.kcore_nums.mask      V1, F0, rel=0
  GRAPH_KERNEL.kcore_frontier.mask  F1, F0, rel=0, k=2
  GRAPH_KERNEL.tri_count_total.mask R0, F0, rel=0
  GRAPH_KERNEL.tri_count_vec.mask   V2, F0, rel=0

  COLLECT.vec V0, out=0
  COLLECT.vec V1, out=1
  COLLECT.vec V2, out=2
  HALT
