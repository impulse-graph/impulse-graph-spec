; ====================================================================
; TDD 51: OP_GATHER_NODE_ATTR BitSet Frontier Masking & ZF Preservation
; Verifies:
; 1. OP_GATHER_NODE_ATTR (0x81) with an active TYPE_BITSET_HANDLE frontier {0, 2}
;    masks out non-frontier nodes {1, 3} to NaN, yielding cardinality R6 = 2 and
;    coalesced sum (with 0.0) R9 = 40.0 (10.0 + 30.0 = 40.0 -> 0x42200000 = 1109393408).
; 2. OP_GATHER_NODE_ATTR (0x81) with an empty TYPE_BITSET_HANDLE frontier from
;    OP_INIT_INPUT_SET masks all elements to NaN and preserves ZF = true per
;    formal contract (sets_vm_flags_mask = 0).
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R6 = 2}
; {EXPECT: R9 = 1109393408}
; {EXPECT: FLAG = ZF}

.data
.array_float MOCK_PRICES = [10.0, 20.0, 30.0, 40.0]
.set FRONTIER_02 = [0, 2]
.set ALL_VALID   = [0, 1, 2, 3]

.text
0x00: OP_LOAD_INLINE_ARRAY       R1, MOCK_PRICES
0x01: OP_LOAD_INLINE_SET         R2, ALL_VALID
0x02: OP_INIT_MOCK_NODE_ATTR     0, R1, R2

; 1. Gather with partial bitset frontier {0, 2} -> [10.0, NaN, 30.0, NaN]
0x03: OP_LOAD_INLINE_SET         R3, FRONTIER_02
0x04: OP_GATHER_NODE_ATTR        R4, R3, 0
0x05: OP_EXTRACT_VALIDITY        R5, R4
0x06: OP_SET_CARDINALITY         R6, R5
0x07: OP_LOAD_CONST_FLOAT        R7, 0.0
0x08: OP_COALESCE                R8, R4, R7
0x09: OP_VECTOR_REDUCE_SUM       R9, R8

; 2. Gather with empty bitset frontier {} -> [NaN, NaN, NaN, NaN] and preserves ZF = true
0x0A: OP_INIT_INPUT_SET          R10, 0
0x0B: OP_GATHER_NODE_ATTR        R11, R10, 0
0x0C: OP_HALT
