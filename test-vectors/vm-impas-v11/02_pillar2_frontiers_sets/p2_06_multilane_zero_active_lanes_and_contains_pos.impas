; {{EXPECT: STATUS = IMPULSE_VM_OK}}
; {{EXPECT: R0 = 0}}
; {{EXPECT: R1 = 0}}
; {{EXPECT: R2 = 0}}
; {{EXPECT: R3 = 0}}
; {{EXPECT: R4 = 1}}
; {{EXPECT: R5 = 0}}
; {{EXPECT: R6 = 5}}
; {{EXPECT: R7 = 0}}

.data
  .domain 0 name="Node" count=6 width=u16
  ; Gotcha §0x24: active_lanes = 0 MUST yield lane_all_nodes == 0 (NOT N_d!)
  .param 0 type=multilane dom=0 width=8 active_lanes=0 entries=[]
  .param 1 type=multilane dom=0 width=8 active_lanes=2 entries=["1:0x5", "3:0x3"]

.code
  LOAD_PARAM.frontier            F0, param=0, dom=0
  LOAD_PARAM.frontier            F1, param=1, dom=0
  INIT_DOMAIN_SPAN               F2, dom=0
  FSEED.empty                    F3, dom=0

  SET_CARDINALITY.lane_pop_sum   R0, F0          ; 0
  SET_CARDINALITY.lane_any_nodes R1, F0          ; 0
  SET_CARDINALITY.lane_all_nodes R2, F0          ; 0 (NOT 6!)
  SET_CARDINALITY.single_lane    R3, F0, lo=0    ; 0

  LOAD_CONST.i32                 R8, 1
  SET_CONTAINS.contains_1bit     R4, F2, R8      ; 1 (in ALL_SPAN)
  SET_CONTAINS.contains_1bit     R5, F3, R8      ; 0 (in EMPTY)
  SET_CONTAINS.get_lane_mask     R6, F1, R8      ; 0x5
  LOAD_CONST.i32                 R9, 2
  SET_CONTAINS.get_lane_mask     R7, F1, R9      ; 0
  HALT
