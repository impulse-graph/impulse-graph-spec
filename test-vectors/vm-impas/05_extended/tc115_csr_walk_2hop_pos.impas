; ====================================================================
; TC115: CSR Walk 2Hop (Positive Test)
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}

.data
.csr_inline  GRAPH_WALK = {
    0: [1, 2],
    1: [3],
    2: [3]
}

.text
0x00: OP_INIT_MOCK_GRAPH     R0, GRAPH_WALK
0x01: OP_INIT_INPUT_NODE     R1, 0
0x02: OP_CSR_WALK_2HOP       R2, R1, R0, R0
0x03: OP_HALT
