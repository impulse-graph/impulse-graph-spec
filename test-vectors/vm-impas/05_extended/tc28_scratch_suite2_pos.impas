; ====================================================================
; TC28: Multi-File Threshold Suite for Scratch Opcodes (Positive Test)
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R0 = 280}
; {EXPECT: FLAG = !ZF}

.text
