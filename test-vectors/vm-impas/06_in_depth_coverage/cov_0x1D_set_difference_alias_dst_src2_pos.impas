; Regression test vector for 4-way differential fuzzing finding (Seed 5498107)
; Verifies OP_SET_DIFFERENCE with dst == src2 does not leak a temporary bitset handle
; so subsequent bitset allocations produce identical handle IDs across all 4 engines.
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: FLAG ZF = true}
.fuel 5000

.data
.csr_inline FUZZ_GRAPH = {
    0: [1, 2],
    1: [2, 3],
    2: [3],
    3: []
}

.text
0x00: OP_INIT_MOCK_GRAPH         R0, FUZZ_GRAPH
0x01: OP_INIT_INPUT_SET          R4
0x02: OP_CSR_WALK                R25, R4, 0
0x03: OP_SET_DIFFERENCE          R25, R4, R25
0x04: OP_CSR_WALK                R29, R4, 0
0x05: OP_HALT
