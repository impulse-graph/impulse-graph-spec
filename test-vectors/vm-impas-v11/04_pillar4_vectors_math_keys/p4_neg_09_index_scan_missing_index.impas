; {{EXPECT: STATUS = IMPULSE_VM_ERR_OUT_OF_BOUNDS}}
; {{EXPECT: PC = 1}}

.data
  .domain 0 name="N" count=3 width=u16
  .node_attr dom=0 attr=0 name="x" type=i64 values=[1, 2, 3]

.code
  LOAD_CONST.i32 R0, 2
  ; No secondary index defined on (dom=0, attr=0)
  INDEX_SCAN.eq  F0, R0, dom=0, attr=0
  HALT
