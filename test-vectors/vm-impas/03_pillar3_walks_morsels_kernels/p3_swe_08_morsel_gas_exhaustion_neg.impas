; {{EXPECT: STATUS = IMPULSE_VM_ERR_GAS_EXHAUSTED}}
; {{EXPECT: MAX_STEPS = 5}}
; SWE-Sweep TDD: WALK_MORSEL with morsel_max=1 over 8 edges must consume gas per slice and trap with ERR_GAS_EXHAUSTED.

.data
  .tier_thresholds morsel_max=1
  .domain 0 name="N" count=9 width=u16
  .relation 0 name="E" src_dom=0 tgt_dom=0
  .csr_inline rel=0 offsets=[0, 8, 8, 8, 8, 8, 8, 8, 8, 8] targets=[1, 2, 3, 4, 5, 6, 7, 8]

.code
  FSEED.single_imm F0, lo=0, hi=0
  WALK_MORSEL.fwd  F0, rel=0
    MORSEL_COMMIT.yield_frontier F1, M1, dom=0
  MORSEL_END
  HALT
