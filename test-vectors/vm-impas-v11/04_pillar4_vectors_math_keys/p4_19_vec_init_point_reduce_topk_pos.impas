; {{EXPECT: STATUS = IMPULSE_VM_OK}}
; {{EXPECT: R0 = 5}}
; {{EXPECT: R1 = 10.0}}
; {{EXPECT: R2 = 1.0}}
; {{EXPECT: R3 = 4.0}}
; {{EXPECT: R4 = 4}}
; {{EXPECT: R5 = 2.5}}
; {{EXPECT: R6 = 10.0}}
; {{EXPECT: R7 = 30.0}}
; {{EXPECT: R8 = 1}}
; {{EXPECT: R9 = 3}}
; {{EXPECT: COLLECT_0 = [3, 2]}}
; {{EXPECT: COLLECT_1 = [1, 0]}}

.data
  .domain 0 name="N" count=5 width=u16
  .param 0 type=f64_vec values=[2.0, 1.0, 3.0, 4.0, null]
  .param 1 type=bool_3vl_vec values=[false, true, null]

.code
  ; Exercise all 14 VEC_INIT subops
  LOAD_CONST.i32          R10, 7
  VEC_INIT.i64.scalar     V0, R10, len=3
  VEC_INIT.u64            V0, len=3
  VEC_INIT.i32            V0, len=3
  VEC_INIT.u32            V0, len=3
  VEC_INIT.f64            V0, len=3
  VEC_INIT.f32            V0, len=3
  VEC_INIT.bool_3vl       V0, len=3
  VEC_INIT.dom_i64        V0, dom=0
  VEC_INIT.dom_u64        V0, dom=0
  VEC_INIT.dom_i32        V0, dom=0
  VEC_INIT.dom_u32        V0, dom=0
  VEC_INIT.dom_f64        V0, dom=0
  VEC_INIT.dom_f32        V0, dom=0
  VEC_INIT.dom_bool_3vl   V0, dom=0

  ; All 4 VEC_POINT subops
  LOAD_PARAM.vec          V1, param=0, type=f64      ; [2, 1, 3, 4, null]
  VEC_POINT.vec_len       R0, V1                     ; 5
  LOAD_CONST.i32          R11, 2
  VEC_POINT.vec_get       R12, V1, R11               ; 3.0
  VEC_POINT.vec_set       V1, R11, R12               ; keep 3.0
  VEC_POINT.vec_cast      V2, V1, lo=0               ; cast f64 -> i64

  ; All 11 VEC_REDUCE subops
  VEC_REDUCE.sum          R1, V1                     ; 10.0
  VEC_REDUCE.min          R2, V1                     ; 1.0
  VEC_REDUCE.max          R3, V1                     ; 4.0
  VEC_REDUCE.count_valid  R4, V1                     ; 4
  VEC_REDUCE.mean         R5, V1                     ; 2.5
  VEC_REDUCE.l1_norm      R6, V1                     ; 10.0
  VEC_REDUCE.l2_norm_sq   R7, V1                     ; 4+1+9+16 = 30.0
  VEC_REDUCE.argmin       R8, V1                     ; 1 (val 1.0)
  VEC_REDUCE.argmax       R9, V1                     ; 3 (val 4.0)
  LOAD_PARAM.vec          V3, param=1, type=bool
  VEC_REDUCE.any_true     R13, V3                    ; 1
  VEC_REDUCE.all_true     R14, V3                    ; 0

  ; All 4 TOP_K subops
  TOP_K.desc_ids          V4, V1, k=2                ; [3, 2]
  TOP_K.asc_ids           V5, V1, k=2                ; [1, 0]
  TOP_K.desc_scores       V6, V1, k=2
  TOP_K.asc_scores        V7, V1, k=2

  COLLECT.vec V4, out=0
  COLLECT.vec V5, out=1
  HALT
