; {{EXPECT: STATUS = IMPULSE_VM_ERR_TYPE_MISMATCH}}
; {{EXPECT: PC = 2}}

.data
  .domain 0 name="User" count=4 width=u16

.code
  FSEED.single_imm           F0, lo=1, hi=0
  LOAD_CONST.i32             R1, 1
  ; get_lane_mask requires multi-lane frontier, not 1-bit
  SET_CONTAINS.get_lane_mask R0, F0, R1
  HALT
