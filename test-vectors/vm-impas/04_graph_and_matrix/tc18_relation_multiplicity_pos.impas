; ====================================================================
; TC18: Relation Multiplicity & Cardinality Directives (Positive Test)
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R0 = 100}
; {EXPECT: FLAG = ZF}

.data
.rel REL_USER_DEPT     = 0, multiplicity = many_to_one
.rel REL_DEPT_COMPANY  = 1, multiplicity = many_to_one
.rel REL_USER_PROJECT  = 2, multiplicity = many_to_many
.rel REL_PASSPORT_USER = 3, multiplicity = one_to_one

.csr_inline DEPT_GRAPH = {
    0: [10],
    1: [10],
    2: [20]
}
.csr_inline EMPTY_GRAPH = {
}

.text
0x00: OP_INIT_MOCK_GRAPH     R0, DEPT_GRAPH
0x01: OP_INIT_MOCK_GRAPH     R1, EMPTY_GRAPH
0x02: OP_INIT_MOCK_GRAPH     R2, EMPTY_GRAPH
0x03: OP_INIT_MOCK_GRAPH     R3, EMPTY_GRAPH
0x04: OP_INIT_INPUT_NODE     R1, 0
0x05: OP_CSR_WALK            R2, R1, REL_USER_DEPT
0x06: OP_CSC_WALK            R3, R2, REL_DEPT_COMPANY
0x07: OP_CSR_DEGREE          R4, R1, REL_USER_PROJECT
0x08: OP_CSR_WALK            R5, R1, REL_PASSPORT_USER
0x09: OP_LOAD_CONST_INT      R0, 100
0x0A: OP_ASSERT              R0, 100
0x0B: OP_HALT
