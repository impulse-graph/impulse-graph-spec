; {{EXPECT: STATUS = IMPULSE_VM_OK}}
; {{EXPECT: R10 = 1}}
; {{EXPECT: R11 = 1}}
; {{EXPECT: F5 = [2] (dom=1)}}
; {{EXPECT: F7 = [0] (dom=1)}}
; ALGO08 (ported from v0.10): Multi-Domain Bipartite Projection & Attribute Filter
; Chains cross-domain traversal from User (dom=0) to Product (dom=1),
; followed by NODE_FILTER.eq.scalar matching.

.data
  .domain 0 name="User" count=2 width=u16
  .domain 1 name="Product" count=3 width=u16
  .relation 0 name="BOUGHT" src_dom=0 tgt_dom=1
  .csr_inline rel=0 offsets=[0, 2, 3] targets=[0, 2, 1]
  .node_attr dom=1 attr=0 name="price" type=i64 values=[10, 20, 30]

.code
  FSEED.single_imm       F2, node=0, dom=0
  WALK.fwd               F3, F2, rel=0
  LOAD_CONST.i32         R4, 30
  NODE_FILTER.eq.scalar  F5, F3, R4, dom=1, attr=0
  SET_CARDINALITY        R10, F5
  LOAD_CONST.i32         R6, 10
  NODE_FILTER.eq.scalar  F7, F3, R6, dom=1, attr=0
  SET_CARDINALITY        R11, F7
  LOAD_CONST.u32         R12, 1
  SCALAR_3VL.cmp_eq_i64  R13, R10, R12
  ASSERT.true_r          R13
  SCALAR_3VL.cmp_eq_i64  R14, R11, R12
  ASSERT.true_r          R14
  HALT
