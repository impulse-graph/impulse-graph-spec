; ====================================================================
; TC31: Register Windowing & Parameter Passing Subroutine (Positive Test)
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R0 = 310}
; {EXPECT: R1 = 42}
; {EXPECT: CALL_STACK_DEPTH = 0}
; {EXPECT: FLAG = !ZF}

.text
0x00: OP_ENTER_FRAME          R16
0x01: OP_LOAD_CONST_INT       R12, 42                   ; Pass parameter 42 in Out register R12
0x02: OP_CALL                 0x06                      ; Call subroutine at 0x06 (window shifts +12)
0x03: OP_LOAD_CONST_INT       R0, 310
0x04: OP_LEAVE_FRAME
0x05: OP_HALT

; Subroutine at 0x06 (R12 of caller becomes R0 of callee)
0x06: OP_ASSERT               R0, 42                    ; Verify In register R0 contains caller's 42
0x07: OP_MOV                  R1, R0                    ; Return value in R1
0x08: OP_RET
