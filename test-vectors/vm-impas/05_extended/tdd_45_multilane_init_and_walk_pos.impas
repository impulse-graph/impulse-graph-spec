; ====================================================================
; TDD_45_MULTILANE_INIT_AND_WALK_POS: Multi-Lane Opcodes 0xC0..0xC4, 0xC7
; Tests:
; 1. OP_LANE_INIT_SEEDS (0xC0) & OP_LANE_INIT_GROUPS (0xC1)
; 2. OP_LANE_SET_EDGE_MASK (0xC2) counterfactual edge trip mask
; 3. OP_LANE_CSR_WALK (0xC3) fixed-point closure & OP_LANE_CSC_WALK (0xC4)
; 4. OP_LANE_REDUCE_AND (0xC7) universal node count (mode 2) & mask (mode 0)
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R10 = 1}
; {EXPECT: R11 = 0}

.data
.csr_inline GRAPH_4 = {
    0: [1, 2],
    1: [3],
    2: [3],
    3: []
}

.text
0x00: OP_INIT_MOCK_GRAPH         R0, GRAPH_4
0x01: OP_LOAD_CONST_INT          R1, 0
0x02: OP_LANE_INIT_SEEDS         R2, R1, 4, 1
0x03: OP_LANE_INIT_GROUPS        R3, R0, R0, 4, 0
0x04: OP_LOAD_CONST_INT          R4, 0
0x05: OP_LANE_SET_EDGE_MASK      R5, R2, R4, 0, 0
0x06: OP_LANE_CSR_WALK           R6, R5, 0, 4
0x07: OP_LANE_REDUCE_AND         R10, R6, 4, 2
0x08: OP_LANE_CSC_WALK           R7, R2, 0, 1
0x09: OP_LANE_REDUCE_AND         R11, R7, 4, 0
0x0A: OP_HALT
