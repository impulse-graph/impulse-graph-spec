; Regression test vector for 4-way differential fuzzing finding (Seeds 5472662, 5479899, 5495408)
; Verifies OP_VEC_MATH_BINARY strictly rejects TYPE_INT64/TYPE_NODE_ID src1 (R23)
; with IMPULSE_VM_ERR_INVALID_REGISTER even when func_id (2) collides with a float register (R2).
; {EXPECT: STATUS = IMPULSE_VM_ERR_INVALID_REGISTER}
.fuel 5000

.data
.csr_inline FUZZ_GRAPH = {
    0: [1, 2],
    1: [2, 3],
    2: [3],
    3: []
}
.array_float ATTR_FLOAT = [1.5, 2.5, 3.5, 4.5]
.array_int ATTR_INT = [10, 20, 30, 40]

.text
0x00: OP_INIT_MOCK_GRAPH         R0, FUZZ_GRAPH
0x01: OP_LOAD_CONST_INT          R1, 42
0x02: OP_LOAD_CONST_FLOAT        R2, 3.5
0x03: OP_INIT_INPUT_NODE         R3, 0
0x04: OP_INIT_INPUT_SET          R4
0x05: OP_LOAD_INLINE_ARRAY       R5, ATTR_FLOAT
0x06: OP_LOAD_INLINE_INT_ARRAY   R6, ATTR_INT
0x07: OP_REDUCE                  R23, R6, 2
0x08: OP_VEC_MATH_BINARY         R29, R23, R5, 2
0x09: OP_HALT
