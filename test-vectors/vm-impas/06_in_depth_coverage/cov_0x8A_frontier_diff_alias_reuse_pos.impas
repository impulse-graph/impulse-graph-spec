; ====================================================================
; COV_0x8A_FRONTIER_DIFF_ALIAS_REUSE_POS:
; Verifies OP_FRONTIER_DIFF handles TYPE_NULL empty operands and
; reuses dst bitset handle when dst != r_curr && dst != r_prev.
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: FLAG_ZF = TRUE}

.data
.csr_inline GRAPH_A = {
    0: [1, 2],
    1: [2, 3],
    2: [3],
    3: []
}

.text
0x00: OP_INIT_MOCK_GRAPH         R0, GRAPH_A
0x01: OP_INIT_INPUT_SET          R4
0x02: OP_MASK_AND                R15, R4, R4
0x03: OP_FRONTIER_DIFF           R15, R4, R4
0x04: OP_FRONTIER_DIFF           R16, R5, R5
0x05: OP_HALT
