; {{EXPECT: STATUS = IMPULSE_VM_OK}}
; {{EXPECT: R0 = 0.0}}
; {{EXPECT: ST = 1, ZF = 1, NF = 0}}

.data
  .domain 0 name="Node" count=4 width=u16
  .param 0 type=multilane dom=0 width=16 active_lanes=2 entries=["0:0x3", "2:0x1"]
  .param 1 type=multilane dom=0 width=16 active_lanes=2 entries=["2:0x1", "0:0x3"]
  .param 2 type=f64_vec values=[-0.0, 2.5, null, -1.0]
  .param 3 type=f64_vec values=[+0.0, 2.5, null, -1.0]

.code
  ; Multilane frontier_eq ignores insertion order
  LOAD_PARAM.frontier      F0, param=0, dom=0
  LOAD_PARAM.frontier      F1, param=1, dom=0
  STABLE_CHECK.frontier_eq F0, F1
  ASSERT.st_set            50

  ; Signed-zero L1 difference: |-0.0 - +0.0| == 0.0 -> ST=1, ZF=1
  LOAD_CONST.f64.ext       R5, 0.0
  LOAD_PARAM.vec           V0, param=2, type=f64
  LOAD_PARAM.vec           V1, param=3, type=f64
  STABLE_CHECK.vec_l1      R0, V0, V1, R5
  HALT
