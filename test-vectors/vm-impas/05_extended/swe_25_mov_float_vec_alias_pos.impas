; ====================================================================
; SWE_25: OP_MOV aliasing with OP_FLOAT_VECTOR_SCALE does not mutate source (Positive Test)
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R2 = 1077936128} ; 3.0f (R0 must remain [1.0, 2.0])
; {EXPECT: R3 = 1086324736} ; 6.0f (R1 scaled by 2.0 -> [2.0, 4.0])

.data
.array_float VEC_A = [1.0, 2.0]

.text
0x00: OP_LOAD_INLINE_ARRAY   R0, VEC_A
0x01: OP_MOV                 R1, R0
0x02: OP_FLOAT_VECTOR_SCALE  R1, 2.0
0x03: OP_VECTOR_REDUCE_SUM   R2, R0
0x04: OP_VECTOR_REDUCE_SUM   R3, R1
0x05: OP_HALT
