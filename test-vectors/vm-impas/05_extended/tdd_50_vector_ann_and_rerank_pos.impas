; ====================================================================
; TDD_50_VECTOR_ANN_AND_RERANK_POS: Hybrid Vector ANN & Rerank (0xCA..0xCB)
; Tests:
; 1. OP_VECTOR_ANN_SEARCH (0xCA) top_k=1 -> BitSet {0} (cardinality R10 = 1)
; 2. OP_VECTOR_RERANK_DOT (0xCB) reranks candidate {0} against QUERY [2.0, 3.0]
;    -> score = 2.0 (IEEE-754 float bits = 1073741824)
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R10 = 1}
; {EXPECT: R11 = 1073741824}

.data
.csr_inline GRAPH_4 = {
    0: [1, 2],
    1: [3],
    2: [3],
    3: []
}
.array_float QUERY = [2.0, 3.0]

.text
0x00: OP_INIT_MOCK_GRAPH         R0, GRAPH_4
0x01: OP_LOAD_INLINE_ARRAY       R1, QUERY
0x02: OP_VECTOR_ANN_SEARCH       R2, R1, 1, 0
0x03: OP_SET_CARDINALITY         R10, R2
0x04: OP_VECTOR_RERANK_DOT       R3, R2, R1, 0, 0
0x05: OP_VECTOR_REDUCE_SUM       R11, R3
0x06: OP_HALT
