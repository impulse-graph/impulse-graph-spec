; ====================================================================
; TDD_32_STREAM_REDUCE_ARGMIN_ARGMAX_POS:
; Test OP_STREAM_REDUCE_ARGMIN (0xB8) and OP_STREAM_REDUCE_ARGMAX (0xB9)
; inside OP_CSR_WALK_STREAM.
; Sources 0 (30.0), 1 (10.0), 2 (50.0) all walk to target 3.
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R4 = 1}          ; argmin source node ID (node 1 has 10.0)
; {EXPECT: R6 = 2}          ; argmax source node ID (node 2 has 50.0)
; {EXPECT: R7 = 1092616192} ; 10.0f reduced min value at target 3
; {EXPECT: R8 = 1112014848} ; 50.0f reduced max value at target 3

.data
.csr_inline GRAPH_A = {
    0: [3],
    1: [3],
    2: [3],
    3: []
}
.array_float ATTR_SOURCE = [30.0, 10.0, 50.0, 0.0]
.set SEEDS = [0, 1, 2]

.text
OP_INIT_MOCK_GRAPH R0, GRAPH_A
OP_LOAD_INLINE_ARRAY R1, ATTR_SOURCE
OP_INIT_MOCK_NODE_ATTR R1, R1, 63
OP_LOAD_INLINE_SET R2, SEEDS
OP_CLEAR_REG R3
OP_CLEAR_REG R4
OP_CLEAR_REG R5
OP_CLEAR_REG R6
OP_CSR_WALK_STREAM R0, R2, 0, 12
OP_VECTOR_REDUCE_SUM R7, R3
OP_VECTOR_REDUCE_SUM R8, R5
OP_HALT

OP_STREAM_FUNC_BEGIN
OP_STREAM_LOAD_SRC 0, 1
OP_STREAM_REDUCE_ARGMIN 0, 3, 4
OP_STREAM_REDUCE_ARGMAX 0, 5, 6
OP_STREAM_FUNC_END
