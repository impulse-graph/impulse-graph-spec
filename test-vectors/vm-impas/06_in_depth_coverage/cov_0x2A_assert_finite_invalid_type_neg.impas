; ====================================================================
; COV_0x2A_ASSERT_FINITE_INVALID_TYPE_NEG:
; Verifies OP_ASSERT_FINITE rejects non-float/non-vector register types
; (such as TYPE_INT64 or TYPE_NULL) with IMPULSE_VM_ERR_INVALID_REGISTER.
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_ERR_INVALID_REGISTER}

.data
.csr_inline GRAPH_A = {
    0: [1],
    1: []
}

.text
0x00: OP_INIT_MOCK_GRAPH         R0, GRAPH_A
0x01: OP_LOAD_CONST_INT          R1, 42
0x02: OP_ASSERT_FINITE           R1
0x03: OP_HALT
