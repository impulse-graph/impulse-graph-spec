; {{EXPECT: STATUS = IMPULSE_VM_OK}}
; {{EXPECT: COLLECT_0 = [1000000000000, -1000000000000, null]}}
; {{EXPECT: COLLECT_1 = [false, true, false]}}
; {{EXPECT: COLLECT_2 = [10, null, null]}}

.data
  .domain 0 name="N" count=3 width=u16
  ; DECIMAL64 128-bit intermediate: 10^12 * 10^12 = 10^24 (> 2^64!), divided by 10^12 = 10^12 exact!
  .param 0 type=i64_vec values=[1000000000000, -1000000000000, null]
  .param 1 type=i64_vec values=[100, 200, 300]
  .param 2 type=i64_vec values=[150, null, 250]
  .param 3 type=f64_vec values=[2.0, 0.0, null]
  .param 4 type=f64_vec values=[1.0, 2.0, 3.0]
  .param 5 type=bool_3vl_vec values=[true, false, null]
  .param 6 type=f64_vec values=[10.0, null, null]

.code
  LOAD_PARAM.vec              V0, param=0, type=i64
  LOAD_CONST.i64.ext          R0, 1000000000000
  VEC_TERNARY.mul_div_i64_r.scalar V1, V0, R0, R0   ; [10^12, -10^12, null]

  ; Temporal validity at ts=220: [100,150)->false, [200,null)->true (open-ended!), [300,250)->false
  LOAD_PARAM.vec              V2, param=1, type=i64
  LOAD_PARAM.vec              V3, param=2, type=i64
  LOAD_CONST.i32              R1, 220
  VEC_TERNARY.time_valid_at_r V4, V2, V3, R1        ; [false, true, false]

  ; Remaining VEC_TERNARY, VEC_BLEND, COALESCE with .scalar and .mask
  LOAD_PARAM.vec              V5, param=3, type=f64
  LOAD_PARAM.vec              V6, param=4, type=f64
  LOAD_CONST.f64.ext          R2, 1.0
  LOAD_CONST.f64.ext          R3, 10.0
  VEC_TERNARY.fma_v.scalar    V7, V5, R2, V6
  VEC_TERNARY.fma_r.scalar    V7, V5, R2, R3
  VEC_TERNARY.lerp_v.scalar   V7, V5, R2, V6
  VEC_TERNARY.lerp_r.scalar   V7, V5, R2, R3
  VEC_TERNARY.clamp_v.scalar  V7, V5, R2, V6
  VEC_TERNARY.clamp_r.scalar  V7, V5, R2, R3
  VEC_TERNARY.safe_div_v.scalar V7, V5, R2, V6
  VEC_TERNARY.safe_div_r.scalar V7, V5, R2, R3

  LOAD_PARAM.vec              V8, param=5, type=bool
  VEC_BLEND.kleene_vv.scalar  V7, V8, R2, V6
  VEC_BLEND.kleene_vr.scalar  V7, V8, R2, R3
  VEC_BLEND.case_vv.scalar    V7, V8, R2, V6
  VEC_BLEND.case_vr.scalar    V7, V8, R2, R3

  LOAD_PARAM.vec              V9, param=6, type=f64
  FSEED.single_imm            F0, lo=0, hi=0
  COALESCE.mask               V10, V9, V6, F0       ; [10, null, null]

  COLLECT.vec V1, out=0
  COLLECT.vec V4, out=1
  COLLECT.vec V10, out=2
  HALT
