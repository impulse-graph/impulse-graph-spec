; ====================================================================
; TDD_39_EXTENDED_128BIT_INSTRUCTIONS_POS: Issue #21
; Tests 128-bit extended instruction decoding (flags & 0x80 + 0xFF
; extension word) in OP_GATHER_NODE_ATTR (attr_id = 38000 >= 256),
; active length in OP_EXTRACT_VALIDITY, and NaN skipping in
; OP_VECTOR_REDUCE_SUM.
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R10 = 2}
; {EXPECT: R11 = 1083179008}

.data
.array_float MOCK_PRICES = [1.5, 99.0, 3.0, 88.0]
.set VALIDITY_MASK = [0, 2]

.text
0x00: OP_LOAD_INLINE_ARRAY     R1, MOCK_PRICES
0x01: OP_LOAD_INLINE_SET       R2, VALIDITY_MASK
0x02: OP_INIT_MOCK_NODE_ATTR   38000, R1, R2

0x03: OP_LOAD_INLINE_SET       R0, VALIDITY_MASK
0x04: OP_GATHER_NODE_ATTR      R3, R0, 0, 38000

0x05: OP_EXTRACT_VALIDITY      R4, R3
0x06: OP_SET_CARDINALITY       R10, R4

0x07: OP_VECTOR_REDUCE_SUM     R11, R3
0x08: OP_HALT
