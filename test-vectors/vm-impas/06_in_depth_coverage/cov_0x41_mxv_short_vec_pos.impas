; Regression test vector for 4-way differential fuzzing finding (Seed 9206244)
; Verifies OP_MXV handles input float vectors shorter than graph node count
; (e.g. length-2 vector from OP_VECTOR_RERANK_DOT over a 4-node graph) by treating
; out-of-range column indices as 0.0f rather than bailing out to an all-zero vector.
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: FLAG ZF = false}
.fuel 5000

.data
.csr_inline FUZZ_GRAPH = {
    0: [1, 2],
    1: [2, 3],
    2: [3],
    3: []
}
.array_float ATTR_FLOAT = [1.5, 2.5, 3.5, 4.5]
.array_int ATTR_INT = [10, 20, 30, 40]

.text
0x00: OP_INIT_MOCK_GRAPH         R0, FUZZ_GRAPH
0x01: OP_LOAD_CONST_INT          R1, 42
0x02: OP_LOAD_CONST_FLOAT        R2, 3.5
0x03: OP_INIT_INPUT_NODE         R3, 0
0x04: OP_INIT_INPUT_SET          R4
0x05: OP_LOAD_INLINE_ARRAY       R5, ATTR_FLOAT
0x06: OP_LOAD_INLINE_INT_ARRAY   R6, ATTR_INT
0x07: OP_ADAPTIVE_WALK           R19, R3, 0
0x08: OP_REDUCE                  R17, R5, 0
0x09: OP_ASSERT_SCRATCH_BYTES    R0
0x0A: OP_VECTOR_RERANK_DOT       R26, R19, R5, 0, 0
0x0B: OP_MXV                     R28, R26, 0
0x0C: OP_HALT
