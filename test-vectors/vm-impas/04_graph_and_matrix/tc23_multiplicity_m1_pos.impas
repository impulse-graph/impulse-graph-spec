; ====================================================================
; TC23: Relation Multiplicity M:1 (Many-to-One Flat Target Array)
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R0 = 23}
; {EXPECT: FLAG = !ZF}

.data
.rel REL_EMP_DEPT = 0, multiplicity = many_to_one

.csr_inline M1_GRAPH = {
    0: [10],
    1: [10],
    2: [20]
}

.text
0x00: OP_INIT_MOCK_GRAPH     R0, M1_GRAPH
0x01: OP_INIT_INPUT_NODE     R1, 0
0x02: OP_CSR_WALK            R2, R1, REL_EMP_DEPT
0x03: OP_COLLECT_BITSET      R3, R2
0x04: OP_LOAD_CONST_INT      R0, 23
0x05: OP_ASSERT              R0, 23
0x06: OP_HALT
