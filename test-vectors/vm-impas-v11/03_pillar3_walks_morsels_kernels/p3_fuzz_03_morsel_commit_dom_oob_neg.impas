; COVERAGE: OP_MORSEL_COMMIT.yield_frontier OP_WALK_MORSEL.fwd
; Corpus Fuzz Bug 1: OP_MORSEL_COMMIT.yield_frontier with OOB dom must return ERR_OUT_OF_BOUNDS (no OCaml crash)
.data
  .domain 0 name="User" count=4 width=u32
  .relation 0 name="FOLLOWS" src_dom=0 tgt_dom=0
  .csr_inline rel=0 offsets=[0, 1, 2, 3, 3] targets=[1, 2, 3]

.code
  INIT_DOMAIN_SPAN.all_span F0, dom=0
  WALK_MORSEL.fwd F0, rel=0
    MORSEL_COMMIT.yield_frontier F1, M1, dom=32
  MORSEL_END
  HALT

; EXPECT: STATUS = IMPULSE_VM_ERR_OUT_OF_BOUNDS
