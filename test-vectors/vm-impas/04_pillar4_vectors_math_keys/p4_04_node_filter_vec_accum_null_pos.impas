; {{EXPECT: STATUS = IMPULSE_VM_OK}}
; {{EXPECT: F1 = [1, 3] (dom=0)}}
; {{EXPECT: F2 = [0, 2] (dom=0)}}
; {{EXPECT: F3 = [0, 1, 2] (dom=0)}}

.data
  .domain 0 name="Node" count=4 width=u16
  .node_attr dom=0 attr=0 name="x" type=i64 values=[10, 20, 30, null]
  .param 0 type=i64_vec values=[20, 20, 20, 20]
  .param 1 type=i64_vec values=[10, 10, 10, 10]

.code
  INIT_DOMAIN_SPAN       F0, dom=0
  LOAD_PARAM.vec         V0, param=0, type=i64
  LOAD_PARAM.vec         V1, param=1, type=i64

  ; Vector RHS + .accum
  NODE_FILTER.eq         F1, F0, V0, dom=0, attr=0      ; {1}
  NODE_FILTER.is_null.accum F1, F0, dom=0, attr=0       ; {1, 3}
  NODE_FILTER.ne         F2, F0, V0, dom=0, attr=0      ; {0, 2}
  NODE_FILTER.lt         F4, F0, V0, dom=0, attr=0
  NODE_FILTER.le         F4, F0, V0, dom=0, attr=0
  NODE_FILTER.gt         F4, F0, V0, dom=0, attr=0
  NODE_FILTER.ge         F4, F0, V0, dom=0, attr=0
  NODE_FILTER.between    F4, F0, V1, V0, dom=0, attr=0
  NODE_FILTER.is_not_null F3, F0, dom=0, attr=0         ; {0, 1, 2}
  HALT
