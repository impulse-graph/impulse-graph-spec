; ====================================================================
; TDD_47_MULTILANE_REDUCE_AND_ATTR_POS: Multi-Lane Opcodes 0xC0, 0xC2..0xC9
; Tests:
; 1. OP_LANE_INIT_SEEDS (0xC0), OP_LANE_SET_EDGE_MASK (0xC2)
; 2. OP_LANE_CSR_WALK (0xC3), OP_LANE_CSC_WALK (0xC4), OP_LANE_PRUNE_MASK (0xC5)
; 3. OP_LANE_FILTER_QUORUM (0xC6) min_k = 2 -> nodes {1, 3} (R10 = 2)
; 4. OP_LANE_REDUCE_AND (0xC7) mode 0 -> Lane 0 reaches all 4 nodes (R11 = 1)
; 5. OP_LANE_REDUCE_ATTR (0xC8) MAX per lane -> [12.0, 12.0] (sum R12 = 24.0 = 1103101952)
; 6. OP_LANE_SET_COVER (0xC9) exact pair cover
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R10 = 2}
; {EXPECT: R11 = 1}
; {EXPECT: R12 = 1103101952}

.data
.csr_inline GRAPH_4 = {
    0: [1, 2],
    1: [3],
    2: [3],
    3: []
}
.array_float SCORES = [3.0, 6.0, 9.0, 12.0]

.text
0x00: OP_INIT_MOCK_GRAPH         R0, GRAPH_4
0x01: OP_LOAD_INLINE_ARRAY       R1, SCORES
0x02: OP_LOAD_CONST_INT          R2, 0
0x03: OP_LANE_INIT_SEEDS         R3, R2, 2, 1
0x04: OP_LANE_SET_EDGE_MASK      R4, R3, R2, 0, 1
0x05: OP_LANE_CSR_WALK           R5, R4, 0, 4
0x06: OP_LANE_CSC_WALK           R6, R5, 0, 1
0x07: OP_LANE_PRUNE_MASK         R7, R5, R2, 0
0x08: OP_LANE_FILTER_QUORUM      R8, R7, 2, 0
0x09: OP_SET_CARDINALITY         R10, R8
0x0A: OP_LANE_REDUCE_AND         R11, R7, 4, 0
0x0B: OP_LANE_REDUCE_ATTR        R9, R7, R1, BINARY_OP_MAX, 1
0x0C: OP_VECTOR_REDUCE_SUM       R12, R9
0x0D: OP_LANE_SET_COVER          R13, R7, R0, 4, 1
0x0E: OP_HALT
