; {{EXPECT: STATUS = IMPULSE_VM_ERR_DOMAIN_MISMATCH}}
; {{EXPECT: PC = 1}}

.data
  .domain 0 name="User" count=4 width=u16
  .domain 1 name="Item" count=4 width=u16
  .relation 0 name="BOUGHT" src_dom=0 tgt_dom=1
  .csr_inline rel=0 offsets=[0, 1, 1, 1, 1] targets=[1]

.code
  ; F0 is dom=1, but rel=0 src_dom=0
  FSEED.single_imm   F0, lo=0, hi=1
  SPMV.fwd_first_src V0, F0, rel=0, attr=0xFFFF
  HALT
