; ====================================================================
; COV_0x24_MASK_AND_OR_NOT_ALIAS_POS:
; Verifies in-place aliasing (dst == src1 / dst == src2) in OP_MASK_NOT,
; OP_MASK_AND, and OP_MASK_OR releases replaced bitset handles without leaking.
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R10 = 4}

.data
.csr_inline GRAPH_A = {
    0: [1],
    1: [2],
    2: [3],
    3: []
}

.text
0x00: OP_INIT_MOCK_GRAPH         R0, GRAPH_A
0x01: OP_INIT_INPUT_SET          R4
0x02: OP_MASK_NOT                R4, R4
0x03: OP_MASK_AND                R4, R4, R4
0x04: OP_MASK_OR                 R4, R4, R4
0x05: OP_ROARING_BITMAP_OR       R5, R4, R4
0x06: OP_SET_CARDINALITY         R10, R5
0x07: OP_HALT
