; {{EXPECT: STATUS = IMPULSE_VM_OK}}
; {{EXPECT: R0 = 0}}
; {{EXPECT: R1 = 99}}
; {{EXPECT: R2 = NULL}}
; {{EXPECT: R3 = 77}}
; {{EXPECT: F0 = [1, 3] (dom=0)}}
; {{EXPECT: F1 = [] (dom=0)}}
; {{EXPECT: F2 = [1, 3] (dom=0)}}

.data
  .domain 0 name="Node" count=6 width=u32
  .param 0 type=frontier dom=0 values=[1, 3]
  .param 1 type=i64_vec values=[10, 20]

.code
  LOAD_CONST.i32      R1, 77
  LOAD_CONST.i32      R3, 99
  SWAP.r              R1, R3                ; R1=99, R3=77
  MOV.r               R0, R1
  MOV.clear_r         R0                    ; R0=0 (valid=1)

  LOAD_PARAM.frontier F0, param=0, dom=0
  MOV.f               F0, F0                ; self-move safety check
  MOV.f               F1, F0
  SPILL.f             F0, slot=0
  SPILL.f             F1, slot=15
  MOV.clear_f         F1, dom=0             ; F1=[] (dom=0)
  SWAP.f              F0, F1                ; F0=[], F1=[1,3]
  RELOAD.f            F2, slot=15           ; F2=[1,3]
  RELOAD.f            F0, slot=0            ; reload slot 0 again (non-destructive)
  MOV.clear_f         F1, dom=0

  LOAD_PARAM.vec      V0, param=1, type=i64
  MOV.v               V1, V0
  SPILL.v             V1, slot=2
  SWAP.v              V0, V2                ; V0=None, V2=vec
  RELOAD.v            V3, slot=2
  MOV.clear_v         V2

  SPILL.r             R2, slot=1            ; spill NULL scalar
  RELOAD.r            R4, slot=1            ; R4=NULL
  ASSERT.is_null_r    R4, 401
  HALT
