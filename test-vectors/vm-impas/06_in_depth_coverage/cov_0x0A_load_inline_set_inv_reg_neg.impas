; ====================================================================
; COV_0x0A_LOAD_INLINE_SET_INV_REG_NEG: OP_LOAD_INLINE_SET (Invalid Register R64)
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_ERR_INVALID_REGISTER}

.data
