.data
.csr_inline GRAPH_FIX = {
    0: [1, 2],
    1: [2],
    2: [0]
}
.set SET_U = [1, 2]
.set SET_V = [2, 3]

.text
0x00: OP_INIT_MOCK_GRAPH     R10, GRAPH_FIX
