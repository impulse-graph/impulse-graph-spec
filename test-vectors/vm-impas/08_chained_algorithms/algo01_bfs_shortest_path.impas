; ====================================================================
; ALGO01: Multi-Hop BFS Frontier Expansion & Reachability
; Tests chained CSR_WALK, SET_UNION, and SET_CARDINALITY reductions.
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R8 = 4}
; {EXPECT: R7 = 0}

.data
.csr_inline DIAMOND = {
    0: [1, 2],
    1: [3],
    2: [3],
    3: []
}

.text
0x00: OP_INIT_MOCK_GRAPH     R0, DIAMOND
0x01: OP_INIT_INPUT_NODE     R1, 0
0x02: OP_CSR_WALK            R2, R1, R0
0x03: OP_SET_UNION           R3, R1, R2
0x04: OP_CSR_WALK            R4, R2, R0
0x05: OP_SET_UNION           R5, R3, R4
0x06: OP_CSR_WALK            R6, R4, R0
0x07: OP_SET_CARDINALITY     R7, R6
0x08: OP_SET_CARDINALITY     R8, R5
0x09: OP_ASSERT              R8, 4
0x0A: OP_ASSERT              R7, 0
0x0B: OP_HALT
