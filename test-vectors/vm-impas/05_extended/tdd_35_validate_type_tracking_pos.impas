; ====================================================================
; TDD_35_VALIDATE_TYPE_TRACKING_POS:
; Verifies that impulse_vm_validate properly tracks destination
; register type transitions across OP_EWISE_ADD, OP_EWISE_MULT,
; OP_REDUCE, and OP_CSR_WALK_STREAM when registers are reused.
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R3 = 1101529088} ; 21.0f (5.0 + 7.0 + 9.0)
; {EXPECT: R6 = 2}          ; cardinality of CSR stream walk targets [1, 2]

.data
.csr_inline GRAPH_A = {
    0: [1, 2],
    1: [],
    2: []
}
.array_float VEC_A = [1.0, 2.0, 3.0]
.array_float VEC_B = [4.0, 5.0, 6.0]

.text
0x00: OP_INIT_MOCK_GRAPH     R0, GRAPH_A
0x01: OP_LOAD_CONST_INT      R2, 99
0x02: OP_LOAD_INLINE_ARRAY   R0, VEC_A
0x03: OP_LOAD_INLINE_ARRAY   R1, VEC_B
0x04: OP_EWISE_ADD           R2, R0, R1, 0
0x05: OP_VECTOR_REDUCE_SUM   R3, R2
0x06: OP_LOAD_CONST_INT      R4, 42
0x07: OP_INIT_INPUT_NODE     R5, 0
0x08: OP_CSR_WALK_STREAM     R4, R5, 0, 11
0x09: OP_SET_CARDINALITY     R6, R4
0x0A: OP_HALT

0x0B: OP_STREAM_FUNC_BEGIN
0x0C: OP_STREAM_FUNC_END
