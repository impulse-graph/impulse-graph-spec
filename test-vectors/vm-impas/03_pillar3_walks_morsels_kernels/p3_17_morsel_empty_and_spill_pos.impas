; {{EXPECT: STATUS = IMPULSE_VM_OK}}
; {{EXPECT: F2 = [] (dom=1)}}
; {{EXPECT: F3 = [] (dom=0)}}
; {{EXPECT: F4 = [1] (dom=0)}}
; {{EXPECT: R2 = 0}}

.data
  .domain 0 name="User" count=3 width=u16
  .domain 1 name="Item" count=3 width=u16
  .relation 0 name="BOUGHT" src_dom=0 tgt_dom=1
  .csr_inline rel=0 offsets=[0, 1, 2, 2] targets=[1, 2]
  .node_attr dom=0 attr=0 name="score" type=f64 values=[5.0, 50.0, null]

.code
  ; Pre-populate F2, F3, R2 to verify empty-frontier WALK_MORSEL clears non-.accum sinks!
  FSEED.single_imm    F2, lo=0, hi=1
  FSEED.single_imm    F3, lo=0, hi=0
  LOAD_CONST.i32      R2, 99
  FSEED.empty         F0, dom=0
  FSEED.empty         F1, dom=1

  WALK_MORSEL.fwd     F0, rel=0
    MORSEL_COMMIT.yield_frontier F2, M1, dom=1
    MORSEL_COMMIT.count_add_r    R2
  MORSEL_END
  ASSERT.empty_f      F2, 701
  ASSERT.zf_set       702

  WALK_MORSEL.rev     F1, rel=0
    MORSEL_COMMIT.yield_frontier F3, M0, dom=0
  MORSEL_END
  ASSERT.empty_f      F3, 703

  ; FILTER_MORSEL with thread-private morsel SPILL.v / RELOAD.v
  INIT_DOMAIN_SPAN    F5, dom=0
  LOAD_CONST.f64.ext  R0, 10.0
  FILTER_MORSEL       F5
    GATHER_NODE_ATTR                  M4, M0, dom=0, attr=0
    SPILL.v                           M4, slot=0
    RELOAD.v                          M5, slot=0
    VEC_CMP.gt.scalar                 M6, M5, R0
    SET_CONVERT.b2f                   MF1, M6
    MORSEL_COMMIT.yield_frontier.mask F4, M0, MF1, dom=0
  MORSEL_END
  HALT
