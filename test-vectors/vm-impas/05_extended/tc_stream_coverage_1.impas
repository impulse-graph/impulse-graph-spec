; ====================================================================
; TC_STREAM_COVERAGE_1: Cover all missing OP_STREAM_* opcodes
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}

.text
0x00: OP_HALT
0x01: OP_INIT_INPUT_SET        R1, 0
0x02: OP_CSR_WALK_STREAM       R1, 0, 0
0x03: OP_STREAM_FUNC_BEGIN
0x04: OP_STREAM_LOAD_TGT       R2, 0
0x05: OP_STREAM_MATH_SUB       R3, R2, R2
0x06: OP_STREAM_MATH_DIV       R4, R3, R3
0x07: OP_STREAM_MATH_MUL       R5, R4, R4
0x08: OP_STREAM_MATH_MOD       R6, R5, R5
0x09: OP_STREAM_CMP_EQ         R7, R6, R6
0x0A: OP_STREAM_CMP_NEQ        R8, R7, R7
0x0B: OP_STREAM_CMP_GT         R9, R8, R8
0x0C: OP_STREAM_CMP_LT         R10, R9, R9
0x0D: OP_STREAM_LOGIC_AND      R11, R10, R10
0x0E: OP_STREAM_LOGIC_OR       R12, R11, R11
0x0F: OP_STREAM_LOGIC_NOT      R13, R12
0x10: OP_STREAM_SELECT         R14, R13, R12, R11
0x11: OP_STREAM_REDUCE_ARGMIN  R15, R14, R14
0x12: OP_STREAM_REDUCE_ARGMAX  R16, R15, R15
0x13: OP_STREAM_LOAD_SRC_ID    R17, 0
0x14: OP_STREAM_LOAD_TGT_ID    R18, 0
0x15: OP_STREAM_LOAD_EDGE_ID   R19, 0
0x16: OP_STREAM_YIELD          R20, 0
0x17: OP_STREAM_SCATTER_REDUCE R21, R20, 0
0x18: OP_STREAM_FUNC_END
0x19: OP_CSC_WALK_STREAM       R1, 0, 0
0x1A: OP_STREAM_FUNC_BEGIN
0x1B: OP_STREAM_FUNC_END
