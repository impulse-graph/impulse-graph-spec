; {{EXPECT: STATUS = IMPULSE_VM_OK}}
; {{EXPECT: F2 = [1, 2] (dom=1)}}
; {{EXPECT: F3 = [0, 1] (dom=0)}}
; {{EXPECT: R2 = 3}}
; {{EXPECT: COLLECT_0 = [0, 150, 500, 0]}}
; P3-19: OP_WALK_MORSEL.coo_fwd and OP_WALK_MORSEL.coo_rev with unsorted COO + explicit edge_ids

.data
  .domain 0 name="User" count=3 width=u16
  .domain 1 name="Item" count=4 width=u16
  .relation 0 name="BOUGHT" src_dom=0 tgt_dom=1
  ; Canonical edge attributes indexed by edge_id 0..3: [10.0, 150.0, 200.0, 300.0]
  ; Unsorted COO edges with explicit edge_ids mapping into canonical edge_attr:
  ;   i=0: (1 -> 2, eid=3, amt=300.0)
  ;   i=1: (0 -> 0, eid=0, amt=10.0)
  ;   i=2: (0 -> 2, eid=2, amt=200.0)
  ;   i=3: (0 -> 1, eid=1, amt=150.0)
  .coo_inline rel=0 sources=[1, 0, 0, 0] targets=[2, 0, 2, 1] edge_ids=[3, 0, 2, 1] order="unsorted"
  .edge_attr rel=0 attr=0 name="amt" type=f64 values=[10.0, 150.0, 200.0, 300.0]
  .param 0 type=frontier dom=0 values=[0, 1]
  .param 1 type=f64_vec values=[0.0, 0.0, 0.0, 0.0]

.code
  LOAD_PARAM.frontier F0, param=0, dom=0
  LOAD_CONST.f64.ext  R0, 100.0
  LOAD_PARAM.vec      V0, param=1, type=f64

  ; Also exercise WALK.coo_fwd and WALK.coo_rev on COO-only relation (no CSR!)
  WALK.coo_fwd        F4, F0, rel=0
  WALK.coo_rev        F5, F4, rel=0

  WALK_MORSEL.coo_fwd F0, rel=0
    GATHER_EDGE_ATTR                 M4, M2, rel=0, attr=0
    VEC_CMP.gt.scalar                M5, M4, R0
    SET_CONVERT.b2f                  MF1, M5
    JCC.jempty_f                     MF1, skip_c
    MORSEL_COMMIT.yield_frontier.mask F2, M1, MF1, dom=1
    MORSEL_COMMIT.scatter_add.mask    V0, M1, M4, MF1
    MORSEL_COMMIT.count_add_r.mask    R2, MF1
  skip_c:
  MORSEL_END

  FSEED.single_imm    F6, node=2, dom=1
  WALK_MORSEL.coo_rev F6, rel=0
    GATHER_EDGE_ATTR                 M4, M2, rel=0, attr=0
    VEC_CMP.gt.scalar                M5, M4, R0
    SET_CONVERT.b2f                  MF1, M5
    MORSEL_COMMIT.yield_frontier.mask F3, M0, MF1, dom=0
  MORSEL_END

  COLLECT.vec         V0, out=0
  HALT
