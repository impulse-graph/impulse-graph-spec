; ====================================================================
; TDD 13: Vector Time Valid At Verification
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R4 = 1}

.data
.csr_inline TIME_GRAPH = {
    0: [1, 2, 3]
}
.array_int ATTR_START = [0, 100, 200, 300]
.array_int ATTR_END   = [0, 150, 250, 350]

.text
0x00: OP_INIT_MOCK_GRAPH         R0, TIME_GRAPH
0x01: OP_LOAD_INLINE_INT_ARRAY   R1, ATTR_START
0x02: OP_INIT_MOCK_NODE_ATTR     10, R1, R255
0x03: OP_LOAD_INLINE_INT_ARRAY   R2, ATTR_END
0x04: OP_INIT_MOCK_NODE_ATTR     20, R2, R255
0x05: OP_LOAD_CONST_INT          R3, 210
; Check which target nodes of relation 0 are active at time 210
; attr_start = 10, attr_end = 20
0x06: OP_VECTOR_TIME_VALID_AT    R5, R3, 0, 10, 20
0x07: OP_SET_CARDINALITY         R4, R5
0x08: OP_ASSERT                  R4, 1
0x09: OP_HALT
