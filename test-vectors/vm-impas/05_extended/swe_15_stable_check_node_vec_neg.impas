; ====================================================================
; SWE_15: OP_STABLE_CHECK with TYPE_NODE_VECTOR (Negative Test)
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_ERR_INVALID_REGISTER}

.data
.array_int NODE_VEC_A = [1, 2, 3]
.array_int NODE_VEC_B = [1, 2, 3]

.text
0x00: OP_LOAD_INLINE_INT_ARRAY R0, NODE_VEC_A
0x01: OP_LOAD_INLINE_INT_ARRAY R1, NODE_VEC_B
0x02: OP_STABLE_CHECK          R2, R0, R1
0x03: OP_HALT
