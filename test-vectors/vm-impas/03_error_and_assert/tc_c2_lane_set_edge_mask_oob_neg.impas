; Group 4 TDD: OP_LANE_SET_EDGE_MASK (0xC2) with OOB rel_id
; {EXPECT: STATUS = IMPULSE_VM_ERR_OUT_OF_BOUNDS}
.data
.csr_inline G = {
    0: [1],
    1: []
}
.array_int seed_arr = [0, 1]
.text
0x00: OP_INIT_MOCK_GRAPH    R0, G
0x01: OP_LOAD_INLINE_SET    R30, seed_arr
0x02: OP_LANE_INIT_SEEDS    R1, R30, 0
0x03: OP_LOAD_CONST_INT     R30, 0
0x04: OP_LANE_SET_EDGE_MASK R5, R1, R30, 9999, 0
0x05: OP_HALT
