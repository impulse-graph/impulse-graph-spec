.data
.csr_inline GRAPH_B = {
    0: [1],
    1: [2],
    2: []
}

.text
0x00: OP_INIT_MOCK_GRAPH     R10, GRAPH_B
0x01: OP_INIT_INPUT_NODE     R0, 0
0x02: OP_BRANDES_FORWARD     R1, R10, R0
0x03: OP_BRANDES_BACKWARD    R2, R10, R1
0x04: OP_HALT
