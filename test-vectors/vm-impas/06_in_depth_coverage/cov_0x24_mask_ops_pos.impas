; ====================================================================
; COV_0x24_MASK_OPS_POS: OP_MASK_AND, OP_MASK_OR, OP_MASK_NOT
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}

.data
.set MASK_A = [0, 1, 2]
.set MASK_B = [1, 2, 3]

.text
0x00: OP_LOAD_INLINE_SET     R0, MASK_A
0x01: OP_LOAD_INLINE_SET     R1, MASK_B
0x02: OP_MASK_AND            R2, R0, R1
0x03: OP_MASK_OR             R3, R0, R1
0x04: OP_MASK_NOT            R4, R0
0x05: OP_HALT
