; {{EXPECT: STATUS = IMPULSE_VM_OK}}
; {{EXPECT: COLLECT_0 = [0, 0, 0, 3, 3, 3]}}
; ALGO03 (ported from v0.10): Weakly Connected Components (Afforest) & Root Reductions
; Tests GRAPH_KERNEL.cc_afforest on a 2-component graph with VEC_REDUCE min/max.

.data
  .domain 0 name="Node" count=6 width=u16
  .relation 0 name="LINK" src_dom=0 tgt_dom=0
  .csr_inline rel=0 offsets=[0, 2, 4, 6, 8, 10, 12] targets=[1, 2, 0, 2, 0, 1, 4, 5, 3, 5, 3, 4]

.code
  GRAPH_KERNEL.cc_afforest V1, rel=0
  VEC_REDUCE.min           R2, V1
  VEC_REDUCE.max           R3, V1
  COLLECT.vec              V1, out=0
  HALT
