; {{EXPECT: STATUS = IMPULSE_VM_OK}}
; {{EXPECT: R1 = 4}}
; {{EXPECT: R2 = 4}}
; {{EXPECT: R3 = 0}}
; P5-02: LANE_INIT_SEEDS, LANE_INIT_GROUPS, LANE_WALK (cyclic graph, empty seeds, NULL seeds, .accum + .mask)

.data
  .domain 0 name="Cycle" count=5 width=u16
  .relation 0 name="NEXT" src_dom=0 tgt_dom=0
  .csr_inline rel=0 offsets=[0, 1, 2, 3, 4, 4] targets=[1, 2, 3, 0]
  .param 0 type=u64_vec values=[0, null, 2]
  .param 1 type=u64_vec values=[0, 1]
  .param 2 type=u64_vec values=[0, 1]
  .param 3 type=u64_vec values=[5, 5, 5, 5]
  .param 4 type=u64_vec values=[]
  .param 5 type=u64_vec values=[3]

.code
  LOAD_PARAM.vec V0, param=0, type=u64
  LOAD_PARAM.vec V1, param=1, type=u64
  LOAD_PARAM.vec V2, param=2, type=u64
  LOAD_PARAM.vec V3, param=3, type=u64
  LOAD_PARAM.vec V4, param=4, type=u64
  LOAD_PARAM.vec V5, param=5, type=u64

  LANE_INIT_SEEDS.auto_width F0, V0, dom=0
  LANE_INIT_SEEDS.force_w64 F1, V4, dom=0
  SET_CARDINALITY.lane_any_nodes R3, F1

  LANE_INIT_GROUPS.groups F2, V1, V2, dom=0, k=0
  LANE_INIT_GROUPS.groups.accum F2, V1, V2, dom=0, k=0

  LANE_INIT_SEEDS.auto_width F11, V5, dom=0

  LANE_WALK.fwd F3, F0, rel=0
  LANE_WALK.rev F4, F0, rel=0
  LANE_WALK.both F5, F0, rel=0
  LANE_WALK.fwd_fixpoint_plus F6, F0, rel=0
  LANE_WALK.fwd_fixpoint_star F7, F0, rel=0
  LANE_WALK.rev_fixpoint_plus F8, F0, rel=0
  LANE_WALK.rev_fixpoint_star F9, F0, rel=0
  LANE_WALK.fwd_edge_masked.accum F3, F0, V3, rel=0
  LANE_WALK.both_fixpoint_star F10, F0, rel=0
  LANE_WALK.both_fixpoint_star_masked.mask F12, F0, V3, F11, rel=0

  SET_CARDINALITY.lane_any_nodes R1, F6
  SET_CARDINALITY.lane_any_nodes R2, F10
  HALT
