; ====================================================================
; COV_0x19_HAS_CSR_POS: OP_HAS_CSR (Sets EQ flag on present CSR)
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}

.data
.csr_inline  GRAPH_HAS_CSR = {
    0: [1]
}

.text
0x00: OP_INIT_MOCK_GRAPH     R0, GRAPH_HAS_CSR
0x01: OP_HAS_CSR             R0, 0
0x02: OP_HALT
