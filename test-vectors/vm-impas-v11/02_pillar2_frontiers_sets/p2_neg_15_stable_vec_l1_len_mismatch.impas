; {{EXPECT: STATUS = IMPULSE_VM_ERR_OUT_OF_BOUNDS}}
; {{EXPECT: PC = 4}}

.data
  .param 0 type=f64_vec values=[1.0, 2.0]
  .param 1 type=f64_vec values=[1.0, 2.0, 3.0]

.code
  LOAD_CONST.f64.ext  R5, 0.1
  LOAD_PARAM.vec      V0, param=0, type=f64
  LOAD_PARAM.vec      V1, param=1, type=f64
  ; Vector length mismatch (2 vs 3)
  STABLE_CHECK.vec_l1 R0, V0, V1, R5
  HALT
