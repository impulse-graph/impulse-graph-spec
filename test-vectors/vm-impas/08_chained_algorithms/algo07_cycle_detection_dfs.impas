; ====================================================================
; ALGO07: Directed Cycle Detection & Frontier Partitioning
; Chains multi-hop CSR walks with visited history set accumulation,
; detecting back-edges via set intersection and frontier difference.
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R10 = 1}
; {EXPECT: R11 = 1}

.data
.csr_inline CYCLE_GRAPH = {
    0: [1],
    1: [2],
    2: [0, 3],
    3: []
}

.text
0x00: OP_INIT_MOCK_GRAPH         R0, CYCLE_GRAPH
0x01: OP_INIT_INPUT_NODE         R1, 0
0x02: OP_SET_UNION               R2, R1, R1
0x03: OP_CSR_WALK                R3, R1, 0
0x04: OP_SET_INTERSECT           R4, R3, R2
0x05: OP_SET_UNION               R2, R2, R3
0x06: OP_CSR_WALK                R5, R3, 0
0x07: OP_SET_INTERSECT           R6, R5, R2
0x08: OP_SET_UNION               R2, R2, R5
0x09: OP_CSR_WALK                R7, R5, 0
0x0A: OP_SET_INTERSECT           R8, R7, R2
0x0B: OP_SET_DIFFERENCE          R9, R7, R2
0x0C: OP_SET_CARDINALITY         R10, R8
0x0D: OP_SET_CARDINALITY         R11, R9
0x0E: OP_ASSERT                  R10, 1
0x0F: OP_ASSERT                  R11, 1
0x10: OP_HALT
