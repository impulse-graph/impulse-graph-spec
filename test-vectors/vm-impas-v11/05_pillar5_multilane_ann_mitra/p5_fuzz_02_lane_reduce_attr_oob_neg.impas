; COVERAGE: OP_LANE_REDUCE_ATTR.sum
; Fuzzer Iter0 Bug 6a: OP_LANE_REDUCE_ATTR with attr vector shorter than node ID in multi-lane frontier must return ERR_OUT_OF_BOUNDS
.data
  .domain 0 name="User" count=8 width=u32
  .param 0 type=u64_vec values=[0, 5]
  .param 1 type=f64_vec values=[1.0, 2.0]

.code
  LOAD_PARAM.vec V0, param=0, type=u64
  LOAD_PARAM.vec V1, param=1, type=f64
  LANE_INIT_SEEDS.auto_width F0, V0, dom=0
  LANE_REDUCE_ATTR.sum V2, F0, V1
  HALT

; EXPECT: STATUS = IMPULSE_VM_ERR_OUT_OF_BOUNDS
