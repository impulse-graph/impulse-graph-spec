; {{EXPECT: STATUS = IMPULSE_VM_OK}}
; {{EXPECT: R0 = -1}}
; {{EXPECT: R0_TYPE = i64}}
; {{EXPECT: R1 = 0xFFFFFFFF}}
; {{EXPECT: R1_TYPE = u64}}
; {{EXPECT: R2 = -0.0}}
; {{EXPECT: R2_TYPE = f64}}
; {{EXPECT: R3 = NULL}}
; {{EXPECT: R3_TYPE = null}}
; {{EXPECT: R4 = 0x80000000}}
; {{EXPECT: R4_TYPE = f32}}
; {{EXPECT: R5 = NULL}}
; {{EXPECT: R6 = -9223372036854775808}}
; {{EXPECT: R6_TYPE = i64}}
; {{EXPECT: R7 = 0xFFFFFFFFFFFFFFFF}}
; {{EXPECT: R7_TYPE = u64}}
; {{EXPECT: R8 = -0.0}}
; {{EXPECT: R8_TYPE = f64}}
; {{EXPECT: R9 = NULL}}
; {{EXPECT: R10 = NULL}}

.code
  LOAD_CONST.i32      R0, -1
  LOAD_CONST.u32      R1, 0xFFFFFFFF
  LOAD_CONST.f32      R2, 0x80000000        ; -0.0f promoted to -0.0d
  LOAD_CONST.f32      R3, 0x7FC00000        ; qNaN f32 -> Kleene NULL
  LOAD_CONST.f32_raw  R4, 0x80000000        ; raw -0.0f preserved in low 32 bits
  LOAD_CONST.f32_raw  R5, 0x7FC00001        ; qNaN f32_raw -> Kleene NULL
  LOAD_CONST.i64.ext  R6, 0x8000000000000000 ; INT64_MIN
  LOAD_CONST.u64.ext  R7, 0xFFFFFFFFFFFFFFFF ; UINT64_MAX
  LOAD_CONST.f64.ext  R8, 0x8000000000000000 ; -0.0d
  LOAD_CONST.f64.ext  R9, 0x7FF8000000000000 ; qNaN f64 -> Kleene NULL
  LOAD_CONST.null     R10
  HALT
