; ====================================================================
; TDD_KCORE_DECOMPOSITION_E2E: OP_KCORE_DECOMPOSITION (0x68)
; Verifies Batagelj-Zaversnik k-core peeling on a 5-node graph:
; - Nodes {0, 1, 2, 3} form a 2-regular 4-cycle (2-core, coreness = 2.0)
; - Node 4 is a degree-1 pendant attached to node 3 (1-shell, coreness = 1.0)
; - Coreness vector R2 = [2.0, 2.0, 2.0, 2.0, 1.0]:
;   - Sum R3 = 9.0 (1091567616)
;   - 2-core cardinality R6 = 4
;   - 1-shell cardinality R9 = 1
; Catches any interpreter stub that treats 0x68 as a no-op.
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R3 = 1091567616}
; {EXPECT: R6 = 4}
; {EXPECT: R9 = 1}
; {EXPECT: FLAG = !ZF}

.data
.csr_inline GRAPH_KCORE_5 = {
    0: [1, 3],
    1: [0, 2],
    2: [1, 3],
    3: [0, 2, 4],
    4: [3]
}

.text
0x00: OP_INIT_MOCK_GRAPH         R0, GRAPH_KCORE_5
0x01: OP_LOAD_CONST_INT          R1, 0
0x02: OP_KCORE_DECOMPOSITION     R2, R1
0x03: OP_VECTOR_REDUCE_SUM       R3, R2
0x04: OP_LOAD_CONST_FLOAT        R4, 2.0
0x05: OP_VEC_CMP_EQ              R5, R2, R4
0x06: OP_SET_CARDINALITY         R6, R5
0x07: OP_LOAD_CONST_FLOAT        R7, 1.0
0x08: OP_VEC_CMP_EQ              R8, R2, R7
0x09: OP_SET_CARDINALITY         R9, R8
0x0A: OP_HALT
