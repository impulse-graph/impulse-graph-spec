; ====================================================================
; TC03: Jumps & Loop Control (Positive Test)
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R0 = 10}
; {EXPECT: FLAG = !ZF}

.text
0x00: OP_LOAD_CONST_INT   R0, 10
0x01: OP_LOAD_CONST_INT   R1, 0
0x02: OP_JZ               3
0x03: OP_LOOP_DECR        R0, 1
0x04: OP_JNZ              2
0x05: OP_NOP
0x06: OP_JMP              2
0x07: OP_LOAD_CONST_INT   R0, 99
0x08: OP_LOAD_CONST_INT   R0, 10
0x09: OP_ASSERT           R0, 10
0x0A: OP_HALT
