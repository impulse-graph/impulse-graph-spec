; {{EXPECT: STATUS = IMPULSE_VM_OK}}
; {{EXPECT: R10 = 42}}
; {{EXPECT: COLLECT_0 = [0.43333333999999996, 0.43333333999999996, 0.43333333999999996]}}
; ALGO02 (ported from v0.10): PageRank Power Iteration & Vector Math Reductions
; Chains SPMV.fwd_plus_times, VEC_MATH_ARITH.add, VEC_REDUCE.sum across 2 iterations.

.data
  .domain 0 name="Node" count=3 width=u16
  .relation 0 name="LINK" src_dom=0 tgt_dom=0
  .csr_inline rel=0 offsets=[0, 1, 2, 3] targets=[1, 2, 0]
  .edge_attr rel=0 attr=0 name="w" type=f64 values=[1.0, 1.0, 1.0]
  .param 0 type=f64_vec values=[0.33333334, 0.33333334, 0.33333334]
  .param 1 type=f64_vec values=[0.05, 0.05, 0.05]

.code
  INIT_DOMAIN_SPAN       F0, dom=0
  LOAD_PARAM.vec         V1, param=0, type=f64
  LOAD_PARAM.vec         V3, param=1, type=f64
  SPMV.fwd_plus_times    V2, F0, V1, rel=0, attr=0
  VEC_MATH_ARITH.add     V4, V2, V3
  SPMV.fwd_plus_times    V5, F0, V4, rel=0, attr=0
  VEC_MATH_ARITH.add     V6, V5, V3
  VEC_REDUCE.sum         R7, V6
  LOAD_CONST.u32         R10, 42
  COLLECT.vec            V6, out=0
  HALT
