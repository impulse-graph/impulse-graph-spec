; ====================================================================
; COV_0x26_MASK_NOT_EMPTY_FLOAT_VEC_POS:
; Verifies OP_MASK_NOT respects logical length 0 on float vectors
; instead of falling back to max_nodes (1024).
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: FLAG_ZF = TRUE}

.data
.csr_inline GRAPH_A = {
    0: [1],
    1: []
}
.array_float ATTR_FLOAT = [1.5, 2.5]

.text
0x00: OP_INIT_MOCK_GRAPH         R0, GRAPH_A
0x01: OP_INIT_INPUT_SET          R4
0x02: OP_LOAD_INLINE_ARRAY       R5, ATTR_FLOAT
0x03: OP_VECTOR_RERANK_DOT       R18, R4, R5, 0, 3
0x04: OP_MASK_NOT                R13, R18
0x05: OP_HALT
