; ====================================================================
; TC29: Degree of Parallelism (DoP) Control & Clamping (Positive Test)
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R0 = 290}
; {EXPECT: R1 = 1}
; {EXPECT: FLAG = !ZF}

.data
.max_dop 1

.text
0x00: OP_SET_MAX_DOP          R1, 1                     ; Request single-threaded execution mode (max_dop = 1)
0x01: OP_LOAD_CONST_INT       R0, 290
0x02: OP_ASSERT               R0, 290
0x03: OP_HALT
