; {{EXPECT: STATUS = IMPULSE_VM_OK}}
; {{EXPECT: R0 = 0}}
; {{EXPECT: R1 = 0}}
; {{EXPECT: R2 = 1}}
; {{EXPECT: R3 = NULL}}
; {{EXPECT: COLLECT_0 = [null, 1, null]}}
; {{EXPECT: COLLECT_1 = [null, null, 1]}}

.data
  .domain 0 name="Node" count=3 width=u16
  .relation 0 name="E" src_dom=0 tgt_dom=0
  ; 1->2
  .csr_inline rel=0 offsets=[0, 0, 1, 1] targets=[2]

.code
  FSEED.empty          F0, dom=0
  DEGREE.sum_fwd_r     R0, F0, rel=0        ; 0
  DEGREE.sum_rev_r     R1, F0, rel=0        ; 0

  FSEED.single_imm     F1, lo=1, hi=0
  FSEED.single_imm     F2, lo=2, hi=0
  DEGREE.vec_fwd_v.mask V0, F1, rel=0       ; [null, 1, null]
  DEGREE.vec_rev_v.mask V1, F2, rel=0       ; [null, null, 1]
  COLLECT.vec          V0, out=0
  COLLECT.vec          V1, out=1

  LOAD_CONST.i32       R5, 2
  LOAD_CONST.null      R6
  DEGREE.node_rev_r    R2, R5, rel=0        ; 1
  DEGREE.node_fwd_r    R4, R5, rel=0        ; 0
  DEGREE.node_rev_r    R3, R6, rel=0        ; NULL
  HALT
