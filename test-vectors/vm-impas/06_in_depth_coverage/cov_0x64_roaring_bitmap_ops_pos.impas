; ====================================================================
; COV_0x64_ROARING_BITMAP_OPS_POS: OP_ROARING_BITMAP_AND, OR, AND_NOT
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}

.data
.set_roaring ROAR_A = [10, 20, 30]
.set_roaring ROAR_B = [20, 30, 40]

.text
0x00: OP_LOAD_INLINE_SET_ROARING R0, ROAR_A
0x01: OP_LOAD_INLINE_SET_ROARING R1, ROAR_B
0x02: OP_ROARING_BITMAP_AND      R2, R0, R1
0x03: OP_ROARING_BITMAP_OR       R3, R0, R1
0x04: OP_ROARING_BITMAP_AND_NOT  R4, R0, R1
0x05: OP_HALT
