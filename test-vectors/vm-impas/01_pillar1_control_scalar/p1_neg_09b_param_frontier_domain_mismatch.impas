; {{EXPECT: STATUS = IMPULSE_VM_ERR_DOMAIN_MISMATCH}}
; {{EXPECT: PC = 0}}

.data
  .domain 0 name="User" count=4 width=u16
  .domain 1 name="Item" count=4 width=u16
  .param 0 type=frontier dom=1 values=[0, 1]

.code
  ; Param 0 is bound to dom=1, requesting dom=0 must fail with DOMAIN_MISMATCH
  LOAD_PARAM.frontier F0, param=0, dom=0
  HALT
