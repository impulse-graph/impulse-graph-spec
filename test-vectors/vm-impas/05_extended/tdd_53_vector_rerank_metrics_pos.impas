; ====================================================================
; TDD_53_VECTOR_RERANK_METRICS_POS:
; Tests OP_VECTOR_RERANK_DOT (0xCB) across all 4 similarity metrics (flags 0..3):
; - flags = 0 (MetricDot):     Dot([1.0, 0.0], [1.0, 0.0]) = 1.0 (0x3F800000 = 1065353216)
; - flags = 1 (MetricL2):      -L2([1.0, 0.0], [0.0, 1.0]) = -2.0 (0xC0000000 = 3221225472)
; - flags = 2 (MetricCosine):  Cos([1.0, 0.0], [1.0, 0.0]) = 1.0 (0x3F800000 = 1065353216)
; - flags = 3 (MetricHamming): -Hamming([1.0, -1.0], [-1.0, 1.0]) = -2.0 (0xC0000000 = 3221225472)
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R10 = 1065353216}
; {EXPECT: R11 = 3221225472}
; {EXPECT: R12 = 1065353216}
; {EXPECT: R13 = 3221225472}

.data
