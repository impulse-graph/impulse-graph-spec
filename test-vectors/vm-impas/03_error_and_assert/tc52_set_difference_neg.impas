; ====================================================================
; TC52: Set Difference Invalid Register Trap (Negative Test)
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_ERR_INVALID_REGISTER}

.text
0x00: OP_INIT_INPUT_SET      R1, 0
0x01: OP_INIT_INPUT_SET      R2, 1
0x02: OP_SET_DIFFERENCE      R65, R1, R2    ; R65 is out of bounds
0x03: OP_HALT
