; {{EXPECT: STATUS = IMPULSE_VM_OK}}
; {{EXPECT: F2 = [0, 1, 2, 3, 4] (dom=0)}}
; {{EXPECT: F3 = [2, 3] (dom=0)}}
; {{EXPECT: F4 = [0, 1] (dom=0)}}
; {{EXPECT: F5 = [0, 1, 4] (dom=0)}}
; {{EXPECT: F6 = [] (dom=0)}}
; {{EXPECT: F7 = [] (dom=0)}}
; {{EXPECT: ZF = 1}}

.data
  .domain 0 name="Node" count=12 width=u32
  .param 0 type=frontier dom=0 values=[0, 1, 2, 3]
  .param 1 type=frontier dom=0 values=[2, 3, 4]

.code
  LOAD_PARAM.frontier F0, param=0, dom=0
  LOAD_PARAM.frontier F1, param=1, dom=0
  SET_OP.union        F2, F0, F1          ; {0,1,2,3,4}
  SET_OP.intersect    F3, F0, F1          ; {2,3}
  SET_OP.diff         F4, F0, F1          ; {0,1}
  SET_OP.sym_diff     F5, F0, F1          ; {0,1,4}

  ; In-place aliasing: dst == s1 and dst == s2 == s1
  MOV.f               F6, F0
  SET_OP.diff         F6, F6, F6          ; A \ A = EMPTY
  MOV.f               F7, F1
  SET_OP.sym_diff     F7, F7, F7          ; B ^ B = EMPTY
  ; Complement of empty + intersect with F0 == F0
  SET_COMPLEMENT      F8, F6
  SET_OP.intersect    F8, F8, F0
  STABLE_CHECK.frontier_eq F8, F0
  ASSERT.st_set       30
  ; Re-check ZF=1 from F7
  SET_OP.diff         F7, F7, F0
  HALT
