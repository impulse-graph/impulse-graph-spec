; Group 1 TDD: OP_CSR_WALK_PREDICATE (0x13) with non-bitset / OOB handle in src
; {EXPECT: STATUS = IMPULSE_VM_ERR_INVALID_REGISTER}
.data
.csr_inline G = {
    0: [1, 2],
    1: [2],
    2: []
}
.text
0x00: OP_INIT_MOCK_GRAPH     R0, G
0x01: OP_LOAD_CONST_FLOAT    R1, 1.5
0x02: OP_CSR_WALK_PREDICATE  R2, R1, 0
0x03: OP_HALT
