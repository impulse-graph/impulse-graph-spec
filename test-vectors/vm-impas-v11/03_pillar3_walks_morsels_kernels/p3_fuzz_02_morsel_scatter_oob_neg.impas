; COVERAGE: OP_WALK_MORSEL.fwd OP_MORSEL_COMMIT.scatter_min
; Fuzzer Iter0 Bug 4: MORSEL_COMMIT.scatter_min into vector shorter than target node ID must return ERR_OUT_OF_BOUNDS (no crash)
.data
  .domain 0 name="User" count=4 width=u32
  .relation 0 name="FOLLOWS" src_dom=0 tgt_dom=0
  .csr_inline rel=0 offsets=[0, 1, 2, 3, 3] targets=[1, 2, 3]
  .edge_attr rel=0 attr=0 name="w" type=f64 values=[1.0, 2.0, 3.0]
  .param 0 type=f64_vec values=[0.0, 0.0]

.code
  INIT_DOMAIN_SPAN.all_span F0, dom=0
  LOAD_PARAM.vec V0, param=0, type=f64
  WALK_MORSEL.fwd F0, rel=0
    GATHER_EDGE_ATTR.vec M4, M2, rel=0, attr=0
    MORSEL_COMMIT.scatter_min V0, M1, M4
  MORSEL_END
  HALT

; EXPECT: STATUS = IMPULSE_VM_ERR_OUT_OF_BOUNDS
