; ====================================================================
; SWE_07: OP_LOAD_INDIRECT negative float zero-extension invariant (Positive Test)
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R3 = 3217031168} ; -1.5f raw 32-bit pattern 0xBFC00000 zero-extended to 64-bit

.data
.array_float NEG_WEIGHTS = [-1.5, -2.5]

.text
0x00: OP_LOAD_INLINE_ARRAY   R1, NEG_WEIGHTS
0x01: OP_LOAD_CONST_INT      R2, 0
0x02: OP_LOAD_INDIRECT       R3, R1, R2, 1
0x03: OP_HALT
