; Group 1 TDD: OP_STABLE_CHECK (0x54) with non-bitset handle
; {EXPECT: STATUS = IMPULSE_VM_ERR_INVALID_REGISTER}
.data
.csr_inline G = {
    0: [1],
    1: []
}
.text
0x00: OP_INIT_MOCK_GRAPH R0, G
0x01: OP_LOAD_CONST_INT  R1, 999999
0x02: OP_INIT_INPUT_SET  R2
0x03: OP_STABLE_CHECK    R2, R1
0x04: OP_HALT
