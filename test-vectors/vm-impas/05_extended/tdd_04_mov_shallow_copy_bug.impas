; ====================================================================
; TDD 04: OP_MOV Bitset Deep Copy Compliance
;
; Tests that OP_MOV performs a deep copy of bitset handles,
; meaning mutations to the destination register do NOT affect
; the source register.
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}

.text
; Initialize R1 with a single element {10}
0x00: OP_LOAD_CONST_INT R1, 10

; Move R1 into R2
0x01: OP_MOV R2, R1

; Mutate R2 by adding {20}
; R2 should now be {10, 20}
0x02: OP_LOAD_CONST_INT R3, 20
0x03: OP_SET_UNION R2, R2, R3

; If Java shallow copy bug exists, R1 will ALSO contain {10, 20}.
; Verify R1's cardinality remains 1.
0x04: OP_SET_CARDINALITY R4, R1
0x05: OP_ASSERT R4, 1

0x06: OP_HALT
