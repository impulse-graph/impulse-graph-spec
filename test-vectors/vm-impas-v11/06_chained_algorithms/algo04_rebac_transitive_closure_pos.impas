; {{EXPECT: STATUS = IMPULSE_VM_OK}}
; {{EXPECT: R8 = 3}}
; {{EXPECT: R9 = 3}}
; {{EXPECT: R10 = 1}}
; {{EXPECT: F7 = [1, 2, 3] (dom=0)}}
; ALGO04 (ported from v0.10): Multi-Tier ReBAC Transitive Group Authorization
; Chains multi-relation traversal across MEMBER_OF and hierarchical PARENT_OF.

.data
  .domain 0 name="Principal" count=4 width=u16
  .relation 0 name="MEMBER_OF" src_dom=0 tgt_dom=0
  .relation 1 name="PARENT_OF" src_dom=0 tgt_dom=0
  .csr_inline rel=0 offsets=[0, 1, 1, 1, 1] targets=[1]
  .csr_inline rel=1 offsets=[0, 0, 1, 2, 2] targets=[2, 3]

.code
  FSEED.single_imm       F2, node=0, dom=0
  WALK.fwd               F3, F2, rel=0
  WALK.fwd               F4, F3, rel=1
  WALK.fwd               F5, F4, rel=1
  SET_OP.union           F6, F3, F4
  SET_OP.union           F7, F6, F5
  SET_CARDINALITY        R8, F7

  ; Verify equivalent transitive closure via WALK.fwd_fixpoint_star
  WALK.fwd_fixpoint_star F8, F3, rel=1
  SET_CARDINALITY        R9, F8

  SCALAR_3VL.cmp_eq_i64  R11, R8, R9
  ASSERT.true_r          R11
  LOAD_CONST.u32         R10, 1
  HALT
