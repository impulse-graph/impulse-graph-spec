; ====================================================================
; TC04: Subroutine Call & Return (Positive Test)
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R10 = 99}
; {EXPECT: FLAG = !ZF}

.text
0x00: OP_LOAD_CONST_INT   R0, 5
0x01: OP_CALL             4
0x02: OP_ASSERT           R10, 99
0x03: OP_HALT
0x04: OP_LOAD_CONST_INT   R10, 99
0x05: OP_RET
