; Regression test vector for 4-way differential fuzzing finding (Seeds 5504161, 5510932)
; Verifies OP_VECTOR_REDUCE_SUM on a zero-length float vector (from OP_VECTOR_RERANK_DOT
; over an empty bitset + OP_EWISE_ADD) sums to 0.0f and sets ZF=true instead of reading max_nodes.
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R14 = 0}
; {EXPECT: FLAG ZF = true}
.fuel 5000

.data
.csr_inline FUZZ_GRAPH = {
    0: [1, 2],
    1: [2, 3],
    2: [3],
    3: []
}
.array_float ATTR_FLOAT = [1.5, 2.5, 3.5, 4.5]

.text
0x00: OP_INIT_MOCK_GRAPH         R0, FUZZ_GRAPH
0x01: OP_INIT_INPUT_SET          R4
0x02: OP_LOAD_INLINE_ARRAY       R5, ATTR_FLOAT
0x03: OP_VECTOR_RERANK_DOT       R25, R4, R5, 0, 0
0x04: OP_EWISE_ADD               R13, R25, R5
0x05: OP_VECTOR_REDUCE_SUM       R14, R13
0x06: OP_HALT
