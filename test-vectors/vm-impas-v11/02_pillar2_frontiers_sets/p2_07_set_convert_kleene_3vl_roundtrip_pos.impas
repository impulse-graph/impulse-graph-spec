; {{EXPECT: STATUS = IMPULSE_VM_OK}}
; {{EXPECT: F0 = [1, 3, 5, 7] (dom=0)}}
; {{EXPECT: F1 = [0, 3, 5] (dom=0)}}
; {{EXPECT: F2 = [1, 3, 5, 7] (dom=0)}}
; {{EXPECT: COLLECT_0 = [1, 3, 5, 7]}}

.data
  .domain 0 name="Node" count=8 width=u32
  ; Unsorted IDs with NULLs: v2f_ids skips NULLs and canonicalizes order
  .param 0 type=i64_vec values=[5, null, 1, 3, null]
  .param 1 type=u64_vec values=[7, 3]
  ; Kleene 3VL: TRUE->1, FALSE->0, NULL->0
  .param 2 type=bool_3vl_vec values=[true, false, null, true, false, null, null, false]
  .param 3 type=bool_3vl_vec values=[false, false, false, false, false, true, false, false]

.code
  LOAD_PARAM.vec           V0, param=0, type=i64
  LOAD_PARAM.vec           V1, param=1, type=u64
  SET_CONVERT.v2f_ids      F0, V0, lo=0          ; {1, 3, 5}
  SET_CONVERT.v2f_ids.accum F0, V1, lo=0         ; {1, 3, 5, 7}

  ; f2v_ids outputs strictly ascending IDs regardless of P0/P1/P2 tier
  SET_CONVERT.f2v_ids      V2, F0
  COLLECT.vec              V2, out=0

  ; b2f Kleene collapse + .accum
  LOAD_PARAM.vec           V3, param=2, type=bool
  LOAD_PARAM.vec           V4, param=3, type=bool
  SET_CONVERT.b2f          F1, V3, lo=0          ; {0, 3}
  SET_CONVERT.b2f.accum    F1, V4, lo=0          ; {0, 3, 5}

  ; f2b -> b2f lossless roundtrip
  SET_CONVERT.f2b          V5, F0
  SET_CONVERT.b2f          F2, V5, lo=0          ; {1, 3, 5, 7}
  HALT
