; {{EXPECT: STATUS = IMPULSE_VM_ERR_DOMAIN_MISMATCH}}
; {{EXPECT: PC = 1}}

.data
  .domain 0 name="User" count=3 width=u16
  .domain 1 name="Item" count=3 width=u16
  .node_attr dom=0 attr=0 name="x" type=i64 values=[1, 2, 3]

.code
  FSEED.single_imm    F0, lo=0, hi=1
  NODE_FILTER.is_null F1, F0, dom=0, attr=0
  HALT
