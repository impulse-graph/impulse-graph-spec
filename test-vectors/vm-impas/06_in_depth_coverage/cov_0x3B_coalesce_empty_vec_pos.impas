; Regression test vector for 4-way differential fuzzing finding (Seed 9184741)
; Verifies OP_COALESCE preserves zero-length float vector produced by
; OP_VECTOR_RERANK_DOT on an empty candidate bitset instead of expanding to backing capacity.
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: FLAG ZF = false}
.fuel 5000

.data
.csr_inline FUZZ_GRAPH = {
    0: [1, 2],
    1: [2, 3],
    2: [3],
    3: []
}
.array_float ATTR_FLOAT = [1.5, 2.5, 3.5, 4.5]
.array_int ATTR_INT = [10, 20, 30, 40]

.text
0x00: OP_INIT_MOCK_GRAPH         R0, FUZZ_GRAPH
0x01: OP_LOAD_CONST_INT          R1, 42
0x02: OP_LOAD_CONST_FLOAT        R2, 3.5
0x03: OP_INIT_INPUT_NODE         R3, 0
0x04: OP_INIT_INPUT_SET          R4
0x05: OP_LOAD_INLINE_ARRAY       R5, ATTR_FLOAT
0x06: OP_LOAD_INLINE_INT_ARRAY   R6, ATTR_INT
0x07: OP_VECTOR_RERANK_DOT       R29, R4, R5, 0, 0
0x08: OP_COALESCE                R21, R29, R2
0x09: OP_HALT
