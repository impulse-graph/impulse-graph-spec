; ====================================================================
; SWE_20: OP_VEC_MATH_UNARY with funcId=1 while R1 holds numeric value (Positive Test)
; ====================================================================
; {EXPECT: STATUS = IMPULSE_VM_OK}
; {EXPECT: R3 = 1077936128} ; 3.0f (abs(-1.0) + abs(-2.0) = 3.0)

.data
.array_float VEC_A = [-1.0, -2.0]

.text
0x00: OP_LOAD_INLINE_ARRAY   R0, VEC_A
0x01: OP_LOAD_CONST_INT      R1, 42
0x02: OP_VEC_MATH_UNARY      R2, R0, 1
0x03: OP_VECTOR_REDUCE_SUM   R3, R2
0x04: OP_HALT
